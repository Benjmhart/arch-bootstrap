#!/usr/bin/env bash
# chore-run NAME -- run one chore, record its outcome, notify.
#
# A chore is chores/NAME/run.sh plus a chore-NAME.timer that starts chore@NAME.service.
# Its LAST LINE of output is the one-line summary. Exit codes are the whole protocol:
#   0   done
#   75  needs you -- a normal, expected outcome (e.g. the USB stick is not plugged in);
#       chore@.service counts it as success so it is a reminder, not a failure
#   *   broken
# A quiet-ok file in chores/NAME/ skips the notification when the chore is ok.
# bootstrap.conf (beside chores/) is sourced into the chore's environment.
set -uo pipefail
name=${1:?usage: chore-run NAME | --resend}
here="$(dirname "$(readlink -f "$0")")"
state="${XDG_STATE_HOME:-$HOME/.local/state}/chores"
# A notification no daemon could show (no display yet: boot, or surfboard's Steam session) waits in unsent/ for
# .xinitrc's `chore-run --resend` (station-maintenance fleet 18). One per chore: a newer outcome replaces it.
if [[ $name == --resend ]]; then
  for f in "$state"/unsent/*; do
    [[ -f $f ]] || continue
    mapfile -t a < "$f"
    notify-send -u "${a[0]}" -a chores "${a[1]}" "${a[2]}" && rm -f "$f"
  done
  exit 0
fi
script="$here/$name/run.sh"
[[ -x $script ]] || { echo "no such chore: $name ($script)" >&2; exit 2; }
mkdir -p "$state/unsent"
started=$(date -Is)

( set -a; [[ -f $here/../bootstrap.conf ]] && . "$here/../bootstrap.conf"; set +a
  exec "$script" ) 2>&1 | tee "$state/$name.log"
rc=${PIPESTATUS[0]}

summary=$(tail -n1 "$state/$name.log")
[[ -n $summary || $rc -eq 0 ]] || summary="exited $rc with no output"
case $rc in
  0)  status=ok        urgency=low ;;
  75) status=needs-you urgency=normal ;;
  *)  status=failed    urgency=critical ;;
esac
jq -n --arg n "$name" --arg s "$started" --arg f "$(date -Is)" --argjson rc "$rc" \
      --arg st "$status" --arg m "$summary" \
  '{name:$n, started:$s, finished:$f, rc:$rc, status:$st, summary:$m}' > "$state/$name.json"
# A chore with a quiet-ok file (low-disk, hourly) notifies only when it is not ok.
if [[ $rc -eq 0 && -e $here/$name/quiet-ok ]]; then rm -f "$state/unsent/$name"
elif notify-send -u "$urgency" -a chores "chore $name: $status" "$summary" 2>/dev/null; then rm -f "$state/unsent/$name"
else printf '%s\n' "$urgency" "chore $name: $status" "${summary//$'\n'/ }" > "$state/unsent/$name"
fi
exit "$rc"
