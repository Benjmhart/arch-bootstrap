#!/usr/bin/env bash
# build-in-guest DISK -- runs as ROOT INSIDE the throwaway Arch live VM that
# make-cloud-image boots; never on a real machine (it WIPES DISK). Everything it needs
# is beside it in /in (unpacked from the input tar by make-cloud-image).
#
# Builds a headless Arch on DISK that boots on BIOS and UEFI, on any KVM/Xen/Nitro
# cloud, and takes its identity from cloud-init at first boot:
#   GPT: 1 MiB BIOS-boot | 256 MiB ESP (/efi) | ext4 / (last, so growpart can grow it)
#   GRUB for i386-pc AND x86_64-efi --removable (EFI/BOOT/BOOTX64.EFI: no NVRAM entry
#   needed, which an uploaded image never has); console on tty0 and ttyS0.
#   Initramfs WITHOUT autodetect: built in a virtio VM, autodetect would keep only
#   virtio and the image would not find its root on AWS Nitro (NVMe) or Xen.
#   User `ben` (locked password until user-data sets one; zsh; wheel; sudo asks for it) with the dotfiles checked out, herdr and
#   claude in ~/.local/bin, arch-bootstrap in ~/projects. cloud-init's default_user is
#   ben, so the provider's SSH key lands in ~ben/.ssh/authorized_keys.
#   NO secrets and no per-machine identity: machine-id, SSH host keys and the pacman
#   keyring are all created on the first boot of each clone.
set -Eeuo pipefail
disk=${1:?usage: build-in-guest DISK}
in=$(dirname "$(readlink -f "$0")")
. "$in/build.env"      # HERDR_VER HERDR_SUM NODE_MAJOR BOOTSTRAP_COMMIT
step() { printf '\n==== %s\n' "$*"; }
trap 'echo "build-in-guest FAILED at line $LINENO: $BASH_COMMAND"' ERR

step "live environment"
systemctl stop reflector.service 2>/dev/null || true   # it would rewrite the mirrorlist under us
cp "$in/mirrorlist" /etc/pacman.d/mirrorlist
systemctl start pacman-init.service                    # the live keyring (oneshot: waits)
pacman -Sy --needed --noconfirm archlinux-keyring      # an ISO weeks old may predate a signing key

step "partition $disk"
sfdisk -q --wipe always "$disk" <<EOF
label: gpt
size=1MiB, type=21686148-6449-6E6F-744E-656564454649
size=256MiB, type=C12A7328-F81F-11D2-BA4B-00A0C93EC93B
type=4F68BCE3-E8CD-4DB1-96E7-FBCAF984B709
EOF
udevadm settle
mkfs.fat -F32 -n EFI "${disk}2" >/dev/null
mkfs.ext4 -q -L root "${disk}3"
mount "${disk}3" /mnt
mount --mkdir "${disk}2" /mnt/efi

step "pacstrap"
mapfile -t pkgs < <(grep -hv '^\s*#' "$in/pkglist-headless.txt" "$in/pkglist-cloud.txt" | awk 'NF {print $1}')
pacstrap -K /mnt base linux grub efibootmgr sudo cloud-init cloud-guest-utils "${pkgs[@]}"
genfstab -U /mnt >> /mnt/etc/fstab
rm -rf /mnt/var/cache/pacman/pkg/*                      # ~600 MiB of downloads, before the languages go on
df -h /mnt | tail -1

step "configure"; [[ -n ${BUILD_DEBUG:-} ]] && set -x
c() { arch-chroot /mnt "$@"; }
ln -sf /usr/share/zoneinfo/UTC /mnt/etc/localtime
sed -i 's/^#en_US.UTF-8/en_US.UTF-8/' /mnt/etc/locale.gen; c locale-gen >/dev/null
echo LANG=en_US.UTF-8 > /mnt/etc/locale.conf

sed -i 's/^HOOKS=(\(.*\)autodetect \(.*\))/HOOKS=(\1\2)/' /mnt/etc/mkinitcpio.conf
sed -i "s/^PRESETS=.*/PRESETS=('default')/" /mnt/etc/mkinitcpio.d/linux.preset
rm -f /mnt/boot/initramfs-linux-fallback.img
c mkinitcpio -P

sed -i -e 's/^GRUB_TIMEOUT=.*/GRUB_TIMEOUT=1/' \
  -e 's/^GRUB_CMDLINE_LINUX_DEFAULT=.*/GRUB_CMDLINE_LINUX_DEFAULT="console=tty0 console=ttyS0,115200"/' \
  /mnt/etc/default/grub
printf '%s\n' 'GRUB_TERMINAL="serial console"' 'GRUB_SERIAL_COMMAND="serial --speed=115200"' >> /mnt/etc/default/grub
c grub-install --target=i386-pc "$disk"
c grub-install --target=x86_64-efi --efi-directory=/efi --removable --no-nvram
c grub-mkconfig -o /boot/grub/grub.cfg

# Network: DHCP on any wired interface. cloud-init renders its own networkd config
# where the provider supplies one (10-cloud-init-*.network sorts first).
cat > /mnt/etc/systemd/network/99-dhcp.network <<EOF
[Match]
Name=en* eth*
[Network]
DHCP=yes
EOF

cat > /mnt/etc/ssh/sshd_config.d/10-cloud.conf <<EOF
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
EOF

cat > /mnt/etc/cloud/cloud.cfg.d/90-arch-bootstrap.cfg <<EOF
# arch-bootstrap cloud image: the provider's SSH key goes to ben, not to a distro user.
system_info:
  default_user:
    name: ben
    lock_passwd: true
    shell: /usr/bin/zsh
    groups: [wheel]
    # sudo needs the password user-data sets (chpasswd, see user-data.example); without one
    # ben has no sudo at all (Ben, 2026-10-09: not passwordless).
    sudo: ["ALL=(ALL) ALL"]
disable_root: true
ssh_pwauth: false
# Ignore provider vendor-data: it outranks this file, and Hetzner's sets
# system_info.default_user to root, so the provider's SSH keys went to root (login
# disabled) and nobody could get in (2026-10-09, task 85). The image's user policy wins.
vendor_data: {enabled: false}
vendor_data2: {enabled: false}
manage_etc_hosts: true
EOF

# Inbound: tailnet only. NOT enabled here: user-data enables it once `tailscale up`
# has succeeded (see user-data.example), so a box whose tailscale failed stays reachable
# on public :22 (key-only) instead of locking itself out.
# ponytail: a static copy of bootstrap.sh's hostfw minus the LAN/docker lines; generate
# both from one place if they start to drift.
cat > /mnt/etc/nftables.conf <<'EOF'
#!/usr/bin/nft -f
# Written by arch-bootstrap chores/cloud-image. Own table only: tailscaled keeps its own.
table inet hostfw
delete table inet hostfw
table inet hostfw {
  chain input {
    type filter hook input priority filter; policy drop;
    ct state established,related accept
    ct state invalid drop
    iif "lo" accept
    iifname "tailscale0" accept
    meta l4proto { icmp, ipv6-icmp } accept
    udp dport 41641 accept
    udp dport { 68, 546 } accept
  }
}
EOF

# The pacman keyring holds a private master key: each clone makes its own at first boot.
cat > /mnt/etc/systemd/system/pacman-init.service <<'EOF'
[Unit]
Description=Initialize the pacman keyring (first boot of a cloud image)
ConditionPathExists=!/etc/pacman.d/gnupg
Before=cloud-final.service
[Service]
Type=oneshot
ExecStart=/usr/bin/pacman-key --init
ExecStart=/usr/bin/pacman-key --populate
[Install]
WantedBy=multi-user.target
EOF

# nix: as beast-arch's /etc/nix/nix.conf, nix-command + flakes; the daemon socket is 0666 and allowed-users is *, so
# ben needs no group. docker: on at boot here (Ben 2026-11-05); bootstrap.sh's lean profile keeps it off on desktops.
grep -q '^experimental-features' /mnt/etc/nix/nix.conf || echo 'experimental-features = nix-command flakes' >> /mnt/etc/nix/nix.conf
# Arch's package creates no /nix/store, and every client command as ben then fails with 'opening file "/nix/store": No
# such file or directory' (Hetzner, 2026-11-05). Same owner and mode as beast-arch's.
c install -d -m 1775 -o root -g nixbld /nix/store
units=(systemd-networkd systemd-resolved systemd-timesyncd sshd earlyoom tailscaled pacman-init nix-daemon.socket docker)
for u in cloud-init-main cloud-init-local cloud-init-network cloud-init cloud-config cloud-final; do
  [[ -e /mnt/usr/lib/systemd/system/$u.service ]] && units+=("$u")
done
c systemctl enable "${units[@]}"

step "user ben"
c useradd -m -G wheel,docker -s /usr/bin/zsh ben
c passwd -l ben >/dev/null
u() { arch-chroot -u ben /mnt env HOME=/home/ben bash -c "$1"; }
cp "$in/dotfiles.tar" /mnt/var/tmp/          # the host's ~/.dot: the repo is private, the image has no key
u "tar -xf /var/tmp/dotfiles.tar -C ~ \
   && git --git-dir ~/.dot --work-tree ~ checkout -f \
   && git --git-dir ~/.dot config status.showUntrackedFiles no \
   && git --git-dir ~/.dot config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*'"
rm /mnt/var/tmp/dotfiles.tar
cp "$in/arch-bootstrap.tar" /mnt/var/tmp/   # not /tmp: arch-chroot mounts a tmpfs there
u "mkdir -p ~/projects ~/.local/bin && tar -xf /var/tmp/arch-bootstrap.tar -C ~/projects"; rm /mnt/var/tmp/arch-bootstrap.tar
u "curl -fsSL https://github.com/herdrdev/herdr/releases/download/v$HERDR_VER/herdr-linux-x86_64 -o ~/.local/bin/herdr \
   && echo '$HERDR_SUM  /home/ben/.local/bin/herdr' | sha256sum -c --quiet && chmod +x ~/.local/bin/herdr"
u "curl -fsSL https://claude.ai/install.sh | bash"
# nvm, as bootstrap.sh stage toolchains pins it; .zshrc sources it unguarded.
# PROFILE=/dev/null: its installer would otherwise append to the dotfiles' .zshrc.
u "curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.1/install.sh | PROFILE=/dev/null bash" >/dev/null
# Languages (beast-arch 85, Ben 2026-11-04): what bootstrap.sh stage 25 gives a desktop -- rust stable (rustup is in
# pkglist-cloud), ghcup's ghc + cabal (stack from pacman), node $NODE_MAJOR via nvm (bootstrap.sh's pin: .zshrc puts only that major on PATH) + the npm globals in pkglist-npm.txt.
cp "$in/pkglist-npm.txt" /mnt/var/tmp/
u "rustup default stable >/dev/null"
# AUR (Ben 2026-11-05): yay and pam_rssh, each built as ben from exactly its pkglist-aur.txt pin, as bootstrap.sh
# aur_build_pinned does; their deps are already in the image (go, git, rustup's cargo, openssl, pam).
for n in yay pam_rssh; do
  pin=$(awk -v n=$n '$1 == n {print $2}' "$in/pkglist-aur.txt"); [[ -n $pin ]]
  u "git clone -q https://aur.archlinux.org/$n.git /var/tmp/aur/$n && cd /var/tmp/aur/$n && git checkout -q $pin && makepkg --noconfirm >/dev/null"
  f=$(u "cd /var/tmp/aur/$n && makepkg --packagelist" | grep "/$n-[0-9]")
  c pacman -U --noconfirm "$f"
done

# sudo over ssh by a touch at the client's YubiKey (Ben 2026-11-05: "yes"), the fleet's design (bootstrap.sh
# setup_yubikey, beast-arch 133): the client forwards an agent holding only its sk keys, .zshenv links it to
# ~/.ssh/sudo-agent.sock, pam_rssh asks it to sign. Trusted keys: /etc/sudo-agent-keys, which ONLY the per-boot filter
# below writes, from /etc/sudo-agent-keys.in (user-data write_files; tools/cloud-box). pam_rssh 1.2.1 does not check the
# user-presence flag, so a plain key there would be passwordless sudo (ruled out, Ben 2026-10-09): the filter keeps
# sk- lines only. No .in = no file = sudo is password-only. The guard skips pam_rssh under sudo -S (password on stdin).
# ponytail: guard copied from bootstrap.sh setup_yubikey (same path and text); change both together.
guard=/usr/local/lib/arch-bootstrap/sudo-u2f-skip filter=/var/lib/cloud/scripts/per-boot/sudo-agent-keys
mkdir -p "/mnt${guard%/*}" "/mnt${filter%/*}"
cat > "/mnt$guard" <<'EOF'
#!/bin/sh
# Written by arch-bootstrap. pam_exec (seteuid) runs this from /etc/pam.d/sudo; exit 0 skips the
# YubiKey for this sudo: stdin is not a terminal (sudo -S), or an ancestor is sshd. With "pipe", only the first.
p=$PPID
case $(readlink "/proc/$p/fd/0") in /dev/pts/*|/dev/tty*) ;; *) exit 0 ;; esac
[ "$1" = pipe ] && exit 1
while [ "$p" -gt 1 ]; do
  case $(cat "/proc/$p/comm") in sshd*) exit 0 ;; esac
  p=$(sed "s/.*) //" "/proc/$p/stat" | cut -d" " -f2)
done
exit 1
EOF
cat > "/mnt$filter" <<'EOF'
#!/bin/sh
# Written by arch-bootstrap chores/cloud-image (station-maintenance beast-arch 85). Every boot (cloud-final): rebuild
# /etc/sudo-agent-keys, the keys pam_rssh accepts for sudo, from user-data's /etc/sudo-agent-keys.in, keeping ONLY
# YubiKey (sk-) keys. A plain key there would mean sudo with no password and no touch. Nothing kept = no file.
set -eu
in=/etc/sudo-agent-keys.in out=/etc/sudo-agent-keys
keys=$(grep -E '^sk-(ssh-ed25519|ecdsa-sha2-nistp256)@openssh\.com [A-Za-z0-9+/=]+( |$)' "$in" 2>/dev/null || true)
if [ -z "$keys" ]; then rm -f "$out"; exit 0; fi
printf '%s\n' "$keys" > "$out.new"; chown root:root "$out.new"; chmod 644 "$out.new"; mv "$out.new" "$out"
EOF
chmod 755 "/mnt$guard" "/mnt$filter"
pam="auth\t\t[success=1 default=ignore]\tpam_exec.so quiet seteuid $guard pipe\nauth\t\tsufficient\tpam_rssh.so auth_key_file=/etc/sudo-agent-keys ssh_agent_addr=/home/\${user}/.ssh/sudo-agent.sock cue [cue_prompt=Touch the YubiKey at your machine]"
awk -v add="$(printf '%b' "$pam")" '/^auth/ && !d { print add; d=1 } { print }' /mnt/etc/pam.d/sudo > /mnt/etc/pam.d/sudo.new
mv /mnt/etc/pam.d/sudo.new /mnt/etc/pam.d/sudo; chmod 644 /mnt/etc/pam.d/sudo
grep -q '^auth.*pam_rssh.so auth_key_file=/etc/sudo-agent-keys ' /mnt/etc/pam.d/sudo
grep -q '^auth.*include.*system-auth' /mnt/etc/pam.d/sudo
# The filter must drop everything but sk- keys, or the build fails: a plain key, an sk key behind an option
# (no-touch-required), a comment; and with nothing kept, leave no file.
printf '%s\n' 'ssh-ed25519 AAAAC3plain plain' 'no-touch-required sk-ssh-ed25519@openssh.com AAAAnt nt' '# sk-ssh-ed25519@openssh.com AAAAc c' \
  'sk-ssh-ed25519@openssh.com AAAAsk1 ok1' 'sk-ecdsa-sha2-nistp256@openssh.com AAAAsk2 ok2' > /mnt/etc/sudo-agent-keys.in
c "$filter"
[[ $(cat /mnt/etc/sudo-agent-keys) == $'sk-ssh-ed25519@openssh.com AAAAsk1 ok1\nsk-ecdsa-sha2-nistp256@openssh.com AAAAsk2 ok2' ]]
printf 'ssh-ed25519 AAAAC3plain plain\n' > /mnt/etc/sudo-agent-keys.in; c "$filter"; [[ ! -e /mnt/etc/sudo-agent-keys ]]
rm /mnt/etc/sudo-agent-keys.in; c "$filter"; [[ ! -e /mnt/etc/sudo-agent-keys ]]
echo "sudo: pam_rssh wired; key filter passed its checks"
rm -rf /mnt/var/tmp/aur /mnt/home/ben/go /mnt/home/ben/.cache/go-build /mnt/home/ben/.cargo/registry /mnt/home/ben/.cargo/git
u "curl --proto '=https' --tlsv1.2 -sSf https://get-ghcup.haskell.org | BOOTSTRAP_HASKELL_NONINTERACTIVE=1 BOOTSTRAP_HASKELL_INSTALL_NO_STACK=1 sh >/dev/null"
u "source ~/.nvm/nvm.sh && nvm install $NODE_MAJOR >/dev/null && grep -vE '^\s*(#|$)' /var/tmp/pkglist-npm.txt | awk '{print \$1}' | xargs -r npm install -g --silent"
rm /mnt/var/tmp/pkglist-npm.txt
# oh-my-zsh + the plugins .zshrc names: bootstrap.sh install_oh_my_zsh does the same
# (clone, never upstream's install.sh, which would replace the dotfiles' .zshrc).
# ponytail: URLs copied from bootstrap.sh OMZ_REMOTE / OMZ_EXTERNAL_PLUGINS.
u "git clone -q --depth 1 https://github.com/ohmyzsh/ohmyzsh.git ~/.oh-my-zsh \
   && git clone -q --depth 1 https://github.com/zsh-users/zsh-autosuggestions.git ~/.oh-my-zsh/custom/plugins/zsh-autosuggestions \
   && git clone -q --depth 1 https://github.com/zsh-users/zsh-syntax-highlighting.git ~/.oh-my-zsh/custom/plugins/zsh-syntax-highlighting"

step "clean"
rm -rf /mnt/etc/pacman.d/gnupg /mnt/etc/ssh/ssh_host_* /mnt/var/cache/pacman/pkg/* /mnt/var/log/journal/*
: > /mnt/etc/machine-id                                # empty = first boot, new id
ln -sf /run/systemd/resolve/stub-resolv.conf /mnt/etc/resolv.conf
echo "arch-bootstrap cloud image, built $(date -u +%F) from arch-bootstrap $BOOTSTRAP_COMMIT" > /mnt/etc/cloud-image-release
df -h /mnt | tail -1
fstrim -v /mnt/efi; fstrim -v /mnt                     # discard=unmap: holes in the host file
umount -R /mnt
echo "build-in-guest: done"
