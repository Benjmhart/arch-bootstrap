#!/usr/bin/env bash
# fleet -- reviewed updates for every machine, run from micro (station-maintenance beast-arch task 80).
#
# Trust model (Ben, 2026-10-08): beast-arch, carbon and media-center are "dirty" -- a compromise may
# happen there, and each can push to GitHub. micro is the trusted place for a fleet push or a
# recovery. So nothing is applied unseen: a push shows every commit since the last approved
# snapshot, with its time and the files it touches, and Ben can exclude any of them. The machines
# then move to exactly the approved commits (fleet-apply), micro first.
#
#   fleet status                  each machine's applied snapshot, the last approved one, and every
#                                 repo with unpushed, diverged or uncommitted work (fleet-apply `repos`)
#   fleet push [stage ...|keys]   1. every machine pushes its own secrets commits (beast-arch first:
#                                    it is the vault's source of truth); out-of-sync machines are
#                                    reported and skipped
#                                 2. packages: when the Arch archive has a newer day than
#                                    arch-bootstrap's repo-date, how many of the fleet's packages
#                                    change (the kernel, mesa, xorg... listed); y commits the new
#                                    date AND the AUR pins (aur-pin auto; held/avoided ones stay) in
#                                    ONE commit: the archive and the AUR move together (Ben
#                                    2026-10-21). No new date, no pin moves (only counted). Then every
#                                    held package (arch-bootstrap `holds`, local ~/.config/fleet/hold)
#                                 3. review, per repo (arch-bootstrap, dotfiles, secrets): every new
#                                    commit with its time, author, subject and files, the risky files
#                                    marked. Exclude any by number: micro reverts them in a throwaway
#                                    checkout and pushes the revert, so they are gone from main too
#                                 4. confirm, then apply the snapshot: micro first; if micro fails,
#                                    nothing else is touched
#                                 "keys" = move to the snapshot and install authorized_keys only
#                                 (an urgent revocation); no bootstrap stages.
#   fleet rollback [all]          re-apply the previous approved snapshot: micro only, or every
#                                 machine. Code, dotfiles AND packages go back (the repo-date of that
#                                 commit; pacman -Syuu downgrades); secrets never do (the vault).
#                                 It cannot undo what a bad commit already did as root -- after
#                                 that, reinstall.
#   fleet stick                   make the rescue stick HERE, on micro, from the approved snapshot
#                                 (for a rebuild: never trust a stick a dirty machine wrote). Refuses
#                                 unless arch-bootstrap and secrets are at the last approved snapshot.
#                                 The stick carries the snapshot log; install.sh offers it (snapshot-pick).
#                                 micro has no KVM, so the stick is written but not VM boot-tested.
#   fleet setup                   once, on micro: the fleet key (see below)
#
# Approved snapshots: ~/.local/state/fleet/snapshots, one line each, "<time> <ab> <dot> <sec> [note]".
# Asks ONCE for the fleet key passphrase (a temporary agent) and ONCE for the shared sudo password
# (stdin), checked here before anything is sent. Review answers come from the terminal.
#
# Env: FLEET_ARCHIVE_URL, FLEET_TODAY (tests), FLEET_HOSTS (default: the other machines), FLEET_KEY, FLEET_SELF_HOST (micro),
# FLEET_VAULT_HOST (beast-arch), FLEET_INPUT (review answers; default /dev/tty), FLEET_STATE,
# FLEET_DOTDIR, FLEET_SECRETS.
set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)
REPO=$(cd "$here/.." && pwd)
SECRETS=${FLEET_SECRETS:-${SECRETS_DIR:-$HOME/secrets}}
DOTDIR=${FLEET_DOTDIR:-$HOME/.dot}
STATE=${FLEET_STATE:-$HOME/.local/state/fleet}
SNAPS=$STATE/snapshots
KEY=${FLEET_KEY:-$HOME/.ssh/id_ed25519_fleet}
SELF=${FLEET_SELF_HOST:-micro}
VAULT_HOST=${FLEET_VAULT_HOST:-beast-arch}
IN=${FLEET_INPUT:-/dev/tty}
read -r -a hosts <<<"${FLEET_HOSTS:-beast-arch carbon media-center surfboard}"   # surfboard: its tailnet name must be "surfboard"
die() { echo "FAIL  $*" >&2; exit 1; }

suffix() { tailscale status --json 2>/dev/null | jq -r '.MagicDNSSuffix // empty'; }
# The fleet key only, never the peer key: a peer-key login would run the request as a shell
# command instead of the forced fleet-apply. -F /dev/null drops ~/.ssh/config's peer stanzas;
# HostKeyAlias keeps the pinned host keys.
# IDS: the YubiKey's fleet key when one is plugged in (unlock), else the passphrase key. One
# connection per machine (ControlMaster), so a YubiKey is touched once per machine per run.
IDS=(-i "$KEY")
fssh() {
  local h=$1; shift
  ssh -F /dev/null "${IDS[@]}" -o IdentitiesOnly=yes -o ConnectTimeout=8 -o HostKeyAlias="$h" \
      -o UserKnownHostsFile="$HOME/.ssh/known_hosts" -o ControlMaster=auto \
      -o ControlPath="$STATE/cm-%C" -o ControlPersist=120 "$h.${SUFFIX}" "$@"
}
on() { local h=$1; shift; if [[ $h == "$SELF" ]]; then "$here/fleet-apply" "$@"; else fssh "$h" "$@"; fi; }

# The three repos of a snapshot.
gitr() { local r=$1; shift
  case $r in ab) git -C "$REPO" "$@" ;; dot) git --git-dir="$DOTDIR" "$@" ;; sec) git -C "$SECRETS" "$@" ;; esac; }
title()  { case $1 in ab) echo arch-bootstrap ;; dot) echo dotfiles ;; sec) echo secrets ;; esac; }
branch() { case $1 in ab) echo main ;; *) echo master ;; esac; }
# Files whose change runs code or changes access, marked in the review.
risk() {  # "<tag> <why>": the tag is shown on the review screen, the rest in the long form
  case $1:$2 in
    ab:bootstrap.sh|ab:install.sh|ab:tools/*|ab:chores/*|ab:pkglist*) echo "root runs as root" ;;
    sec:arch-bootstrap/bootstrap.conf) echo "root runs as root (sourced by bootstrap.sh)" ;;
    sec:ssh/*) echo "ssh who can log in / push" ;;
    sec:Passwords.kdbx) echo "vault the vault" ;;
    dot:.zshrc|dot:.zshenv|dot:.zprofile|dot:.xinitrc|dot:.xprofile|dot:bin/*|dot:.local/bin/*|dot:.config/systemd/*|dot:.claude/*|dot:.config/xmonad/*|dot:.xmonad/*)
      echo "you runs as you" ;;
  esac
}

# The review: every repo's new commits on ONE cleared screen, one line each, numbered A1..
# (arch-bootstrap), D1.. (dotfiles), S1.. (secrets), fitted to the terminal (Ben 2026-10-21: small
# screens, and a tty does not scroll), then ONE prompt that also confirms. The long form (files,
# risk marks, secret-scan and AUR pin lines, held packages) goes to $STATE/review.txt; "l" and "d"
# open it in less, which scrolls on a tty. git itself never pages: GIT_PAGER=cat.
export GIT_PAGER=cat PAGER=cat
declare -A HEADS=() CMT=() ONE=() TAGS=() NEW=()   # HEADS[ab]=sha; CMT[A2]=sha; ONE[A2]="date subject"
ORD=(); SUMMARY=()
SECRET_HITS=0
letter() { case $1 in ab) echo A ;; dot) echo D ;; sec) echo S ;; esac; }
repo_of() { case $1 in A) echo ab ;; D) echo dot ;; S) echo sec ;; esac; }

list_repo() {  # list_repo <repo> <base>: print its new commits; fills HEADS and CMT
  local r=$1 base=$2 head i c t L id f; local -a commits files
  gitr "$r" fetch -q origin || die "$(title "$r"): fetch failed"
  head=$(gitr "$r" rev-parse "origin/$(branch "$r")"); HEADS[$r]=$head
  gitr "$r" merge-base --is-ancestor "$base" "$head" \
    || die "$(title "$r"): origin/$(branch "$r") no longer contains the last approved commit ${base:0:7} -- history was rewritten (a force push?). Stop and look before anything is applied."
  mapfile -t commits < <(gitr "$r" rev-list --reverse "$base..$head")
  L=$(letter "$r")
  NEW[$r]=${#commits[@]}
  if (( ${#commits[@]} == 0 )); then printf '\n== %s: nothing new (at %s)\n' "$(title "$r")" "${head:0:7}"; return; fi
  printf '\n== %s: %d new since %s\n' "$(title "$r")" "${#commits[@]}" "${base:0:7}"
  for i in "${!commits[@]}"; do
    c=${commits[i]}; id=$L$((i+1)); CMT[$id]=$c; ORD+=("$id"); TAGS[$id]=""
    ONE[$id]=$(gitr "$r" log -1 --date=format-local:'%m-%d %H:%M' --format='%ad  %s' "$c")
    gitr "$r" log -1 --date=format-local:'%F %H:%M' --format="  $id  %h  %ad  %an  %s" "$c"
    mapfile -t files < <(gitr "$r" show --format= --name-only "$c")
    for f in "${files[@]}"; do t=$(risk "$r" "$f"); [[ -n $t && " ${TAGS[$id]} " != *" ${t%% *} "* ]] && TAGS[$id]+=" ${t%% *}"; done
    for f in "${files[@]:0:6}"; do t=$(risk "$r" "$f"); echo "        $f${t:+    <- ${t#* }}"; done
    (( ${#files[@]} > 6 )) && echo "        ... and $(( ${#files[@]} - 6 )) more"
    # Secrets that should not be in git (beast-arch 76): a KeeShare key and a browser profile went into the dotfiles
    # unflagged. The secrets repo is where they belong, so it is not scanned. --no-renames: a moved file's content
    # counts as added (the 2026-10-16 leak was a rename). Names the file and the kind, never the text.
    if [[ $r != sec ]]; then
      while IFS= read -r t; do echo "        !! POSSIBLE SECRET  $t"; (( ++SECRET_HITS )); TAGS[$id]+=" SECRET?"; done \
        < <(gitr "$r" show --no-renames --format= -p "$c" | "$here/secret-scan")
    fi
    # A moved AUR pin is code that will run as root on every machine: name each move with its versions.
    if [[ $r == ab ]] && printf '%s\n' "${files[@]}" | grep -qx pkglist-aur.txt; then
      TAGS[$id]+=" aur"
      while IFS= read -r t; do echo "        AUR pin  $t"; done \
        < <("$here/aur-pin" changes <(gitr ab show "$c^:pkglist-aur.txt" 2>/dev/null) <(gitr ab show "$c:pkglist-aur.txt") 2>&1)
    fi
  done
}

exclude() {  # exclude <repo> <sha...>: revert them in a throwaway worktree, push; sets $picked
  local r=$1; shift; local tmp head=${HEADS[$r]} out
  tmp=$(mktemp -d)
  gitr "$r" worktree add -q --detach "$tmp" "$head" || die "$(title "$r"): worktree failed"
  out=$(printf '%s\n' "$@" | tac)
  if ! git -C "$tmp" revert --no-commit $out >/dev/null 2>&1; then
    git -C "$tmp" revert --abort 2>/dev/null; gitr "$r" worktree remove --force "$tmp"
    die "$(title "$r"): excluding those conflicts with later commits -- exclude the later ones too, or keep them"
  fi
  git -C "$tmp" commit -q -m "fleet review on micro: exclude $# commit(s)" \
    -m "$(for c in "$@"; do gitr "$r" log -1 --format='%h %s' "$c"; done)" || die "$(title "$r"): revert commit failed"
  git -C "$tmp" push -q origin "HEAD:refs/heads/$(branch "$r")" \
    || { gitr "$r" worktree remove --force "$tmp"; die "$(title "$r"): pushing the revert failed (origin moved during the review? re-run)"; }
  picked=$(git -C "$tmp" rev-parse HEAD)
  gitr "$r" worktree remove --force "$tmp"; gitr "$r" fetch -q origin
  echo "did   $(title "$r"): excluded $#, revert ${picked:0:7} pushed"
}

REV=$STATE/review.txt
pager() { if [[ -t 1 ]] && command -v less >/dev/null; then less -R; else cat; fi; }

draw() {  # the review screen, fitted to the terminal
  local rows cols budget cap r L id n shown line
  rows=$(tput lines 2>/dev/null || echo 24); cols=$(tput cols 2>/dev/null || echo 80)
  [[ -t 1 ]] && clear
  echo "fpush review -- $(date '+%F %H:%M')"
  printf '%s\n' "${SUMMARY[@]}"
  (( SECRET_HITS )) && echo "!! $SECRET_HITS POSSIBLE SECRET(S) (tagged SECRET?): d <id> to look; drop it unless it is a false alarm"
  # rows left for commit lines: header above, one title per repo, two prompt lines
  budget=$(( rows - 1 - ${#SUMMARY[@]} - (SECRET_HITS ? 1 : 0) - 3 - 3 ))
  cap=$(( budget / 3 )); (( cap < 2 )) && cap=2
  for r in ab dot sec; do
    L=$(letter "$r"); n=${NEW[$r]:-0}
    printf '%-15s %s\n' "$(title "$r")" "$( (( n )) && echo "$n new" || echo "nothing new (${HEADS[$r]:0:7})")"
    shown=0
    for id in "${ORD[@]}"; do
      [[ ${id:0:1} == "$L" ]] || continue
      if (( shown == cap - 1 && n > cap )); then echo "  ... $(( n - shown )) more: l lists them"; break; fi
      line="  $(printf '%-4s' "$id")${ONE[$id]}"
      local tag=${TAGS[$id]# }; tag=${tag:+  [${tag}]}
      (( ${#line} + ${#tag} > cols )) && line="${line:0:$(( cols - ${#tag} - 1 ))}~"
      echo "$line$tag"; (( ++shown ))
    done
  done
}

review_all() {  # review_all <base-ab> <base-dot> <base-sec>: one screen, one prompt; sets ab dot sec
  local ans tok r k; local -A ex=()
  { list_repo ab "$1"; list_repo dot "$2"; list_repo sec "$3"
    [[ -s ${PKGDIR:-}/holds.txt ]] && cat "$PKGDIR/holds.txt"; } > "$REV"
  for r in ab dot sec; do [[ -n ${HEADS[$r]:-} ]] || die "$(title "$r"): review failed (see above)"; done
  while :; do
    draw
    if (( ${#CMT[@]} )); then
      printf '\ny = apply all   x A2 S1 = drop those, apply the rest\nd A2 = one commit   l = long list   q = abort: '
    else printf '\nnothing new: y = re-apply the snapshot   l = long list   q = abort: '; fi
    IFS= read -r ans <&3 || die "no answer -- aborted, nothing applied"
    case $ans in
      q) die "aborted at review, nothing applied" ;;
      y|Y) break ;;
      l) pager < "$REV"; continue ;;
      d\ *) k=${ans#d }; k=${k^^}
            if [[ -n ${CMT[$k]:-} ]]; then gitr "$(repo_of "${k:0:1}")" show --stat -p "${CMT[$k]}" | head -400 | pager
            else echo "  no commit $k"; sleep 1; fi; continue ;;
      x\ *) ex=(); for tok in ${ans#x }; do tok=${tok^^}
              [[ -n ${CMT[$tok]:-} ]] || { echo "  no commit $tok"; sleep 1; continue 2; }
              ex[$(repo_of "${tok:0:1}")]+="${CMT[$tok]} "
            done; break ;;
    esac
  done
  for r in ab dot sec; do
    if [[ -n ${ex[$r]:-} ]]; then exclude "$r" ${ex[$r]}; else picked=${HEADS[$r]}; fi
    printf -v "$r" '%s' "$picked"
  done
}

# ---- packages: arch-bootstrap's `repo-date` pins every machine to one day of the Arch Linux
# Archive, and `holds` keeps single packages back on single machines (beast-arch 76, Ben
# 2026-10-09: "declarative versioned systems that are easy to roll back").
ALA=${FLEET_ARCHIVE_URL:-https://archive.archlinux.org/repos}
TODAY=${FLEET_TODAY:-$(date +%F)}
WATCH='linux|linux-lts|linux-zen|linux-firmware.*|.*-ucode|mesa|vulkan-.*|xorg-server.*|xf86-.*|glibc|systemd|pacman|grub|openssh|sudo|tailscale|nvidia.*|cryptsetup|mkinitcpio'

pkgvers() {  # pkgvers <date> <dir>: "name version" for every package in that day's repos
  local r
  for r in core extra multilib; do
    curl -sfL --max-time 300 -o "$2/$r.db" "$ALA/${1//-//}/$r/os/x86_64/$r.db" || continue
    bsdtar -tf "$2/$r.db" | sed -n 's#/desc$##p'
  done | awk '{ n = split($0, a, "-"); v = a[n-1] "-" a[n]; print substr($0, 1, length($0) - length(v) - 1), v }' | sort -u
}

bump_date() {  # offer the newest archive day; a yes commits it to arch-bootstrap and pushes. Sets PKGDIR
  local cur new d tmp ans n
  gitr ab fetch -q origin || die "arch-bootstrap: fetch failed"
  cur=$(gitr ab show origin/main:repo-date 2>/dev/null) || return 0      # not pinned: nothing to offer
  echo; echo "=== packages: pinned to the Arch archive of $cur"
  for d in "$TODAY" "$(date -d "$TODAY - 1 day" +%F)"; do
    curl -sfI --max-time 30 "$ALA/${d//-//}/core/os/x86_64/core.db" >/dev/null && { new=$d; break; }
  done
  [[ -n ${new:-} ]] || { echo "note  the archive did not answer: the date stays $cur"; SUMMARY+=("packages  $cur (the archive did not answer)"); aur_ready; return 0; }
  [[ $new > $cur ]] || { echo "ok    $cur is the newest day"; SUMMARY+=("packages  $cur, the newest day"); aur_ready; return 0; }
  PKGDIR=$(mktemp -d)
  pkgvers "$cur" "$PKGDIR" > "$PKGDIR/old"; pkgvers "$new" "$PKGDIR" > "$PKGDIR/new"
  [[ -s $PKGDIR/old && -s $PKGDIR/new ]] || { echo "note  could not read the archive's package lists: the date stays $cur"; aur_ready; return 0; }
  # Only what the fleet has: this machine's packages and every pkglist.
  { pacman -Qq; for f in $(gitr ab ls-tree --name-only origin/main | grep '^pkglist'); do
      gitr ab show "origin/main:$f" | grep -vE '^[[:space:]]*(#|$)' | awk '{print $1}'; done; } | sort -u > "$PKGDIR/ours"
  awk 'FILENAME == ARGV[1] { o[$1]; next } FILENAME == ARGV[2] { a[$1] = $2; next }
       ($1 in o) && a[$1] != $2 { print $1, ($1 in a ? a[$1] : "(new)"), "->", $2 }' \
    "$PKGDIR/ours" "$PKGDIR/old" "$PKGDIR/new" > "$PKGDIR/changes"
  n=$(wc -l < "$PKGDIR/changes")
  echo "      $new is newer: $n of the fleet's packages change. To watch:"
  grep -E "^($WATCH$(gitr ab show origin/main:holds 2>/dev/null | awk '!/^#/ && NF { printf "|%s", $2 }')) " "$PKGDIR/changes" | sed 's/^/        /'
  while :; do
    printf 'move the date %s -> %s? y = yes; p = print all %d; Enter = keep %s: ' "$cur" "$new" "$n" "$cur"
    IFS= read -r ans <&3 || die "no answer -- aborted, nothing applied"
    case $ans in
      p) sed 's/^/  /' "$PKGDIR/changes" ;;
      y|Y) break ;;
      *) echo "ok    the date stays $cur"; SUMMARY+=("packages  $cur kept ($new offered)"); aur_ready; return 0 ;;
    esac
  done
  tmp=$(mktemp -d)
  gitr ab worktree add -q --detach "$tmp" origin/main || die "arch-bootstrap: worktree failed"
  echo "$new" > "$tmp/repo-date"
  aur_pins "$tmp/pkglist-aur.txt"
  git -C "$tmp" commit -q -m "packages: archive $new ($n package changes since $cur), $AUR_N AUR pin(s) moved" \
      -m "$(cat "$PKGDIR/changes")" -m "${AUR_OUT:-}" -- repo-date $( (( AUR_N )) && echo pkglist-aur.txt) \
    && git -C "$tmp" push -q origin HEAD:refs/heads/main \
    || { gitr ab worktree remove --force "$tmp"; die "arch-bootstrap: committing or pushing the new date failed (origin moved? re-run)"; }
  echo "did   archive $new + $AUR_N AUR pin(s) committed and pushed ($(git -C "$tmp" rev-parse --short HEAD)); it is in the review below"
  SUMMARY+=("packages  $cur -> $new ($n changes) + $AUR_N AUR pin(s): one commit below")
  gitr ab worktree remove --force "$tmp"; gitr ab fetch -q origin
  cp "$PKGDIR/new" "$PKGDIR/date"
}

# AUR pins move themselves (Ben 2026-10-17: "I don't want to be manually updating pins"), and only together with the
# archive date (Ben 2026-10-21: "arch archive + aur should move together"): aur-pin auto moves each to the newest AUR
# commit micro first saw 3+ days ago, unless the line says "# hold". A change that looks like a compromise (an added
# npm/bun/curl/..., a new download host, a SKIP checksum) is avoided; a new committer or a changed .install waits 14
# days (aur-pin's docstring). The moves go into the date's commit, so the review can still exclude them.
aur_pins() {  # aur_pins <pkglist-aur.txt>: run aur-pin auto on it; sets AUR_OUT and AUR_N (pins moved)
  AUR_OUT=; AUR_N=0
  [[ -f $1 ]] || return 0
  echo; echo "=== AUR pins: each moves to the newest AUR commit seen ${AUR_PIN_COOLDOWN_DAYS:-3}+ days ago, unless held or avoided"
  if ! AUR_OUT=$(AUR_PIN_LIST="$1" "$here/aur-pin" auto 2>&1); then
    echo "warn  aur-pin auto failed, no pin moves: $(tail -1 <<<"$AUR_OUT")"
    SUMMARY+=("AUR       aur-pin FAILED: $(tail -1 <<<"$AUR_OUT")"); AUR_OUT=
    gitr ab show origin/main:pkglist-aur.txt > "$1"; return 0
  fi
  [[ -n $AUR_OUT ]] && sed 's/^/  /' <<<"$AUR_OUT"
  AUR_N=$(grep -c '^move ' <<<"$AUR_OUT")
}

aur_ready() {  # no new date: fetch the AUR (the 3-day cooldown counts from micro's first sight) and count, move nothing
  local f; f=$(mktemp)
  gitr ab show origin/main:pkglist-aur.txt > "$f" 2>/dev/null || { rm -f "$f"; return 0; }
  aur_pins "$f" >/dev/null; rm -f "$f"
  (( AUR_N )) && SUMMARY+=("AUR       $AUR_N pin(s) ready; they move with the next archive date")
  return 0
}

show_holds() {  # every held package on every machine: installed, what the pinned day has, what broke
  local date h p ver src broke why have; local -A inst=()
  date=$(gitr ab show origin/main:repo-date 2>/dev/null) || return 0
  PKGDIR=${PKGDIR:-$(mktemp -d)}
  for h in "$SELF" "${hosts[@]}"; do
    while read -r _ p ver src; do inst[$h:$p]="$ver ${src:-}"; done < <(on "$h" status 2>/dev/null | grep '^hold ')
  done
  { gitr ab show origin/main:holds 2>/dev/null | awk '!/^#/ && NF'
    for k in "${!inst[@]}"; do [[ ${inst[$k]} == *\ local ]] && echo "${k%%:*} ${k#*:} - -- local (~/.config/fleet/hold)"; done
  } | sort > "$PKGDIR/holds"
  [[ -s $PKGDIR/holds ]] || return 0
  [[ -s $PKGDIR/date ]] || pkgvers "$date" "$PKGDIR" > "$PKGDIR/date"
  show_holds_list | tee "$PKGDIR/holds.txt"
  local newer; newer=$(grep -c 'NEWER now' "$PKGDIR/holds.txt")
  SUMMARY+=("holds     $(wc -l < "$PKGDIR/holds") held package(s)$( (( newer )) && echo ", $newer NEWER now: try them"); l lists them")
}
show_holds_list() {
  local h p broke why have
  echo; echo "=== held packages (kept at their installed version; the date $date has the version shown)"
  while read -r h p broke _ why; do
    have=$(awk -v p="$p" '$1 == p { print $2 }' "$PKGDIR/date")
    printf '  %-13s %-22s installed %-14s %s has %-14s' "$h" "$p" "$(cut -d' ' -f1 <<<"${inst[$h:$p]:-?}")" "$date" "${have:-?}"
    if [[ $broke != - && -n $have && $have != "$broke" ]]; then printf '  broke at %s <- NEWER now: try it, then drop the hold' "$broke"
    elif [[ $broke != - ]]; then printf '  broke at %s' "$broke"; fi
    printf '\n                %s\n' "$why"
  done < "$PKGDIR/holds"
}

# apply_all <ab> <dot> <sec> <hosts...> -- stages in $stages, password in $pw. Fills result[].
apply_all() {
  local ab=$1 dot=$2 sec=$3; shift 3; local h st rc micro_ok=1
  for h in "$@"; do
    if (( ! micro_ok )); then result[$h]="not attempted ($SELF failed)"; continue; fi
    if [[ -n ${secrets_bad[$h]:-} ]]; then result[$h]="FAILED secrets out of sync, not updated: ${secrets_bad[$h]#FAIL  secrets: }"; continue; fi
    st=$(on "$h" status 2>&1 | tail -1)
    if [[ ${stages[*]:-} != keys && $st == "$ab $dot $sec "*" rc=0 "* ]]; then result[$h]="skip (already at this snapshot)"; continue; fi
    # The bootstrap's output goes to a log here on micro, not the screen: one line per machine (Ben 2026-10-21).
    local log=$STATE/apply-$h.log t0=$SECONDS
    printf '=== %-13s applying ... ' "$h"
    printf '%s\n' "$pw" | on "$h" apply "$ab" "$dot" "$sec" "${stages[@]}" > "$log" 2>&1; rc=$?
    if (( rc == 0 )); then result[$h]="ok"; echo "ok ($(( (SECONDS - t0) / 60 ))m$(( (SECONDS - t0) % 60 ))s)"
    else
      result[$h]="FAILED rc=$rc -- $log"; echo "FAILED rc=$rc"
      # what stopped it: the warnings and the stop line, colour codes stripped
      sed 's/\x1b\[[0-9;?]*[a-zA-Z]//g; s/\x1b\][^\x07\x1b]*\(\x07\|\x1b\\\)//g' "$log" \
        | grep -E '(^| )(warn|FAIL|ERROR|error:|Stopped at)' | tail -6 | sed 's/^ */      /'
    fi
    [[ $h == "$SELF" ]] && (( rc != 0 )) && micro_ok=0
  done
}

unlock() {  # the fleet key (one passphrase) and the sudo password (stdin), both checked first
  SUFFIX=$(suffix); [[ -n $SUFFIX ]] || die "not on the tailnet"
  eval "$(ssh-agent -s)" >/dev/null
  trap 'ssh-agent -k >/dev/null 2>&1' EXIT
  # A plugged-in YubiKey with a fleet key made for it (beast-arch 88), no passphrase. ONE touch per push:
  # a presence check signs with the touch key (~/.ssh/id_ed25519_sk_<serial>), then every machine is
  # reached with that YubiKey's no-touch key (id_ed25519_sk_nt_<serial>, authorized `no-touch-required`;
  # still unusable without the key plugged in, and forced to fleet-apply). Without an nt key: touch per
  # machine. Without a YubiKey: the passphrase key, as before.
  local s k sk=()
  for s in $(ykman list --serials 2>/dev/null); do [[ -f $HOME/.ssh/id_ed25519_sk_$s ]] && sk+=("$s"); done
  if (( ${#sk[@]} )); then
    s=${sk[0]}; k=$HOME/.ssh/id_ed25519_sk_$s
    if [[ -f $HOME/.ssh/id_ed25519_sk_nt_$s ]]; then
      echo "fleet key: YubiKey $s -- touch it once now"
      ssh-keygen -Y sign -q -f "$k" -n fleet-presence </dev/null >/dev/null || die "YubiKey not touched -- nothing sent anywhere"
      k=$HOME/.ssh/id_ed25519_sk_nt_$s
    else
      echo "fleet key: YubiKey $s -- touch it once per machine when it blinks"
    fi
    ssh-add -t 3600 "$k" || die "YubiKey fleet key not loaded"
    IDS=(-i "$k")
  else
    [[ -f $KEY ]] || die "no $KEY -- run: fleet setup"
    ssh-add -t 3600 "$KEY" || die "fleet key not loaded"
  fi
  sudo_locked && die "sudo is locked here until $(sudo_locked) (pam_faillock, 3 failed tries) -- nothing sent anywhere"
  IFS= read -r -s -p "sudo password (shared by every machine): " pw; echo
  printf '%s\n' "$pw" | sudo -S -p '' -k -v 2>/dev/null || die "sudo password rejected here -- nothing sent anywhere.$(
    sudo_locked >/dev/null && echo " sudo is now LOCKED until $(sudo_locked) (pam_faillock)")"
}

# pam_faillock locks sudo for 10 min after 3 failures in 15 min, and a wrong password piped to `sudo -S` costs TWO
# (sudo asks again, stdin is empty, that counts too): two wrong fpush passwords lock it, and from then on the RIGHT
# one is "rejected" too (micro, 2026-10-17 10:27). Prints the unlock time and succeeds while locked.
sudo_locked() {
  local -a t; mapfile -t t < <(faillock --user "$USER" 2>/dev/null | awk '$NF == "V" { print $1 " " $2 }')
  (( ${#t[@]} >= 3 )) || return 1
  local until; until=$(date -d "${t[-1]} 600 sec" +%s) || return 1
  (( until > $(date +%s) )) && date -d "@$until" +%T
}

# Work that has not reached origin, on every machine (fleet-apply `repos`; station-maintenance beast-arch 76):
# unpushed or diverged commits and uncommitted changes in the system repos and every ~/projects/* checkout.
# Only what needs a person is printed; "behind" alone is not lost work (fpush or a pull fixes it).
repos_report() {
  local h path br a b d f note any=0 out
  echo; echo "=== work not on origin (as of each repo's last fetch)"
  for h in "$SELF" "${hosts[@]}"; do
    out=$(on "$h" repos 2>/dev/null | grep '^repo ')
    # No lines is never "clean": the host's fleet-apply predates `repos`, or it did not answer.
    [[ -n $out ]] || { printf '%-13s %s\n' "$h" "NO REPORT (unreachable, or its fleet-apply predates \`repos\`: next fpush)"; any=1; continue; }
    while read -r _ path br rest; do
      a=0 b=0 d=0 f=?
      [[ $rest =~ ahead=([0-9]+)\ behind=([0-9]+) ]] && a=${BASH_REMATCH[1]} b=${BASH_REMATCH[2]}
      [[ $rest =~ dirty=([0-9]+) ]] && d=${BASH_REMATCH[1]}
      [[ $rest =~ fetched=(-?[0-9]+)h ]] && f=${BASH_REMATCH[1]}
      note=""
      if (( a && b )); then note="DIVERGED: $a unpushed, $b behind"; elif (( a )); then note="$a unpushed"; fi
      [[ $br == detached ]] && (( d == 0 )) && continue
      (( d )) && note+="${note:+; }$d uncommitted"
      [[ $rest == no-upstream* ]] && note+="${note:+; }no upstream"
      [[ -z $note ]] && continue
      [[ $f == -1 ]] && f="never fetched" || f="fetched ${f}h ago"   # -1: no FETCH_HEAD, never fetched (read as "-1h ago" 2026-10-17)
      printf '%-13s %-42s %s  (%s)\n' "$h" "$path [$br]" "$note" "$f"; any=1
    done <<<"$out"
  done
  (( any )) || echo "nothing: every repo on every machine is pushed and clean"
  return 0
}

table() {  # print results; nonzero if anything failed
  local h bad=0; echo; echo "=== $1"
  for h in "$SELF" "${hosts[@]}"; do printf '%-14s %s\n' "$h" "${result[$h]:-}"; [[ ${result[$h]:-} == ok || ${result[$h]:-} == skip* || ${result[$h]:-} == "not touched"* ]] || bad=1; done
  return $bad
}

cmd=${1:-status}; shift || true
case $cmd in
setup)
  [[ $(uname -n) == "$SELF" ]] || die "run setup on $SELF"
  [[ -f $KEY ]] || ssh-keygen -t ed25519 -f "$KEY" -C "ben@$SELF fleet" || die "ssh-keygen failed"
  ssh-keygen -y -P '' -f "$KEY" >/dev/null 2>&1 && die "$KEY has no passphrase -- give it one (ssh-keygen -p -f $KEY)"
  ip=$(tailscale ip -4 | head -n1); [[ -n $ip ]] || die "no tailnet IP"
  mkdir -p "$SECRETS/ssh/fleet"
  cp "$KEY.pub" "$SECRETS/ssh/fleet/$SELF.pub"
  blob=$(awk '{print $2}' "$KEY.pub")
  for h in "${hosts[@]}"; do
    f=$SECRETS/ssh/authorized_keys/$h
    [[ -f $f ]] || { echo "skip  $h: no tracked authorized_keys"; continue; }
    grep -vF " $blob" "$f" > "$f.tmp" || true; mv "$f.tmp" "$f"   # drop an older line for this key
    printf 'from="%s",command="%s/tools/fleet-apply",restrict %s\n' "$ip" "$REPO" "$(cat "$KEY.pub")" >> "$f"
    echo "did   $h: fleet key authorized (forced command, from=$ip)"
  done
  echo "todo  git -C $SECRETS add ssh && git -C $SECRETS commit -m '$SELF: fleet key' && git -C $SECRETS push"
  echo "todo  then on each machine, once, by hand: tools/authorized-keys apply (keys otherwise arrive with the next fleet push)"
  ;;
status)
  SUFFIX=$(suffix)
  for h in "$SELF" "${hosts[@]}"; do
    st=$(on "$h" status 2>&1 | tail -1)
    [[ $st =~ ^([0-9a-f]{40})\ ([0-9a-f]{40})\ ([0-9a-f]{40})\ (.*)$ ]] && st="${BASH_REMATCH[1]:0:7} ${BASH_REMATCH[2]:0:7} ${BASH_REMATCH[3]:0:7} ${BASH_REMATCH[4]}"
    printf '%-14s %s\n' "$h" "$st"
  done
  if [[ -s $SNAPS ]]; then read -r t a d s _ < <(tail -1 "$SNAPS"); echo "approved       ${a:0:7} ${d:0:7} ${s:0:7} $t"; else echo "approved       none yet"; fi
  repos_report
  ;;
push)
  stages=("$@")
  mkdir -p "$STATE"
  exec 3<"$IN" || die "no terminal for the review ($IN)"
  unlock
  declare -A result=() secrets_bad=()

  # 1. Each machine hands its own secrets commits to origin, the vault's source of truth first.
  order=(); for h in "$SELF" "${hosts[@]}"; do [[ $h == "$VAULT_HOST" ]] && order=("$h" "${order[@]}") || order+=("$h"); done
  echo "=== secrets: each machine pushes its own commits"
  for h in "${order[@]}"; do
    out=$(on "$h" secrets-push 2>&1); rc=$?; echo "$out"
    (( rc == 0 )) || secrets_bad[$h]=$(tail -1 <<<"$out")
  done
  if (( ${#secrets_bad[@]} )); then for h in "${!secrets_bad[@]}"; do SUMMARY+=("secrets   $h FAILED, it will not be updated: ${secrets_bad[$h]#FAIL  secrets: }"); done
  else SUMMARY+=("secrets   every machine's own commits are pushed"); fi

  # 2. The weekly package date, if it is time (its commit then shows in the review), and every hold.
  bump_date; show_holds

  # 3. Review against the last approved snapshot (the first time: what micro has checked out).
  if [[ -s $SNAPS ]]; then read -r _ b_ab b_dot b_sec _ < <(tail -1 "$SNAPS")
  else b_ab=$(gitr ab rev-parse HEAD); b_dot=$(gitr dot rev-parse HEAD); b_sec=$(gitr sec rev-parse HEAD)
       echo; echo "note  no approved snapshot yet: reviewing from what $SELF has checked out now"; fi
  review_all "$b_ab" "$b_dot" "$b_sec"
  [[ -t 1 ]] && clear
  echo "fpush: arch-bootstrap ${ab:0:7}  dotfiles ${dot:0:7}  secrets ${sec:0:7} -> $SELF, then ${hosts[*]}"

  # 4. micro first; it records the snapshot once it holds it.
  apply_all "$ab" "$dot" "$sec" "$SELF" "${hosts[@]}"
  # Record the snapshot once micro holds it -- unless it is the one already recorded (a push with
  # nothing new must not make `fleet rollback` "roll back" to the same snapshot).
  if [[ ${result[$SELF]} == ok || ${result[$SELF]} == skip* ]]; then
    mkdir -p "$STATE"; last=$(tail -1 "$SNAPS" 2>/dev/null | cut -d' ' -f2-4)
    [[ $last == "$ab $dot $sec" ]] || echo "$(date -Iseconds) $ab $dot $sec" >> "$SNAPS"
  fi
  unset pw
  repos_report
  table "fleet push: arch-bootstrap ${ab:0:7}  dotfiles ${dot:0:7}  secrets ${sec:0:7}"; rc=$?
  echo
  if (( rc == 0 )); then echo "FPUSH OK -- every machine is at this snapshot"
  else echo "FPUSH FAILED -- see the lines above; full logs: $STATE/apply-<machine>.log"; fi
  exit $rc
  ;;
rollback)
  scope=${1:-micro}; [[ $scope == micro || $scope == all ]] || die "usage: fleet rollback [all]"
  [[ $(wc -l < "$SNAPS" 2>/dev/null || echo 0) -ge 2 ]] || die "no earlier approved snapshot to roll back to"
  read -r t ab dot sec _ < <(tail -2 "$SNAPS" | head -1)
  exec 3<"$IN" || die "no terminal ($IN)"
  printf 'roll %s back to the snapshot approved %s (arch-bootstrap %s, dotfiles %s; secrets stay; packages go back to the archive of %s)? [y/N] ' \
    "$( [[ $scope == all ]] && echo "every machine" || echo "$SELF")" "$t" "${ab:0:7}" "${dot:0:7}" "$(gitr ab show "$ab:repo-date" 2>/dev/null || echo "-- (not pinned then)")"
  IFS= read -r ans <&3; [[ $ans == y || $ans == Y ]] || die "not rolled back"
  declare -A result secrets_bad; stages=()
  if [[ $scope == all ]]; then unlock; targets=("$SELF" "${hosts[@]}")
  else IFS= read -r -s -p "sudo password: " pw; echo
       printf '%s\n' "$pw" | sudo -S -p '' -k -v 2>/dev/null || die "sudo password rejected"
       targets=("$SELF"); for h in "${hosts[@]}"; do result[$h]="not touched (rollback micro)"; done; fi
  apply_all "$ab" "$dot" "$sec" "${targets[@]}"
  [[ ${result[$SELF]} == ok ]] && echo "$(date -Iseconds) $ab $dot $sec rollback-of-$(tail -1 "$SNAPS" | cut -d' ' -f1)" >> "$SNAPS"
  unset pw
  table "fleet rollback ($scope) to $t"
  ;;
stick)
  [[ $(uname -n) == "$SELF" ]] || die "make the recovery stick on $SELF -- a stick written by a dirty machine is what this avoids"
  [[ -s $SNAPS ]] || die "no approved snapshot yet -- run fpush first"
  read -r t ab dot sec _ < <(tail -1 "$SNAPS")
  gitr ab cat-file -e "$ab^{commit}" 2>/dev/null || die "the approved commit ${ab:0:7} is not in this checkout -- run fpush first"
  [[ $(gitr sec rev-parse HEAD) == "$sec" ]] || die "secrets here is not at the approved snapshot ${sec:0:7} -- run fpush first"
  # Any USB stick with room will do (Ben, 2026-10-08): list them, the weekly stick's serial first.
  usual=$(bash -c 'source "$1" >/dev/null 2>&1; echo "${RESCUE_USB_SERIAL:-}"' _ "$REPO/bootstrap.conf")
  mapfile -t sticks < <(lsblk -dbno PATH,SIZE,TRAN,SERIAL | awk '$3=="usb" && $2 >= 8e9 {print $1, $2, $4}')
  (( ${#sticks[@]} )) || die "no USB stick of 8 GB or more is plugged in"
  echo "USB sticks (8 GB or more):"
  def=1
  for i in "${!sticks[@]}"; do
    read -r p bytes ser <<<"${sticks[i]}"
    v=$(lsblk -lno LABEL "$p" | grep -qx Ventoy && echo "Ventoy" || echo "NO Ventoy -- would be ERASED")
    [[ -n $usual && $ser == "$usual" ]] && def=$((i+1))
    printf '  %d  %s  %s GB  %s  serial %s  [%s]\n' $((i+1)) "$p" $((bytes/1000000000)) \
      "$(lsblk -dno MODEL "$p" | sed 's/ *$//')" "${ser:-none}" "$v"
  done
  exec 3<"$IN" || die "no terminal ($IN)"
  printf 'which stick? Enter = %d: ' "$def"; IFS= read -r n <&3; n=${n:-$def}
  [[ $n =~ ^[0-9]+$ ]] && (( n >= 1 && n <= ${#sticks[@]} )) || die "no stick $n"
  read -r disk _ <<<"${sticks[n-1]}"
  if ! lsblk -lno LABEL "$disk" | grep -qx Ventoy; then
    printf 'put Ventoy on %s? EVERYTHING on it is lost. Type ERASE: ' "$disk"; IFS= read -r a <&3
    [[ $a == ERASE ]] || die "left $disk alone"
    sudo ventoy -i "$disk" || die "ventoy install failed on $disk"
  fi
  echo "making the rescue stick on $SELF from the snapshot approved $t (arch-bootstrap ${ab:0:7}) on $disk"
  # Build from a throwaway worktree AT the approved commit, never from the live checkout: on
  # 2026-10-08 a commit made in micro's checkout mid-build put an unreviewed install.sh onto the
  # stick (the guard above had passed at the start). A worktree of a commit id cannot change.
  wt=$(mktemp -d); trap 'gitr ab worktree remove --force "$wt" 2>/dev/null; rm -rf "$wt"' EXIT
  gitr ab worktree add -q --detach "$wt" "$ab" || die "worktree at ${ab:0:7} failed"
  RESCUE_USB_DISK=$disk FLEET_SNAPSHOTS=$SNAPS SECRETS_DIR=$SECRETS "$wt/chores/rescue-usb/run.sh"
  ;;
*) die "usage: fleet status | push [stage ...|keys] | rollback [all] | stick | setup" ;;
esac
