#!/usr/bin/env python3
"""secret-scan: read a unified diff on stdin, print one line per suspected secret in an ADDED line or path.

Used by `fleet` in the review (station-maintenance beast-arch 76): a KeeShare private key sat in the dotfiles from
2022 and a whole Vivaldi profile (Login Data, Cookies) from 2020, and nothing on the path flagged either. Prints
"<file>: <pattern> (<n> lines)" -- NEVER the matched text, so the review screen does not leak what it warns about.
Feed it `git show --no-renames -p`: with renames on, a moved file's content is not shown as added (the 2026-10-16 key
leak was a rename). Exit 0 always (it informs the review; the reviewer decides). `--self-test` checks the patterns."""
import re, sys
from collections import Counter

# Built from pieces so this file does not match itself.
BEGIN = "-----" + "BEGIN"
CONTENT = {
    "private key block": BEGIN + r" [A-Z ]*PRIVATE KEY",
    "base64 key (PKCS#8/RSA)": r"MII[CEJ][A-Za-z0-9+/]{60}",
    "GitHub token": r"gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}",
    "Anthropic/OpenAI key": r"sk-(?:ant-)?[A-Za-z0-9_-]{24,}",
    "AWS key id": r"AKIA[0-9A-Z]{16}",
    "Slack token": r"xox[abposr]-[A-Za-z0-9-]{10,}",
    "Google API key": r"AIza[0-9A-Za-z_-]{35}",
    "GitLab token": r"glpat-[A-Za-z0-9_-]{20}",
    "Tailscale key": r"tskey-[a-z]+-[A-Za-z0-9]{10,}",
    "JWT": r"eyJ[A-Za-z0-9_-]{15,}\.eyJ[A-Za-z0-9_-]{15,}\.",
    "credentials in a URL": r"[a-z]{2,10}://[^/\s:@]{1,64}:[^/\s:@$]{4,64}@",
    "password/token assignment": r"(?i)\b(?:password|passwd|secret|token|api[_-]?key|client_secret)\b\s*[:=]\s*[\"']?(?=[^\s\"'$<{(]*\d)(?=[^\s\"'$<{(]*[A-Za-z])[^\s\"'$<{(]{12,}",
}
PATHS = {
    "browser profile data": r"(?:^|/)(?:Login Data|Cookies|Web Data|History|Current Session|Local Storage|Session Storage)(?:$|/|-journal)",
    "key or vault file": r"(?:^|/)(?:id_(?:rsa|ed25519|ecdsa)(?:_sk)?|.*\.pem|.*\.p12|.*\.kdbx|\.netrc|\.pgpass|.*\.keyfile|.*\.key)$",
    "shell history": r"(?:^|/)\.(?:bash|zsh)_history$|(?:^|/)\.histfile$",
    "credentials file": r"(?:^|/)(?:\.cred[^/]*|credentials(?:\.json)?|\.git-credentials|auth\.json|\.env)$",
}
SELF = "tools/secret-scan"
LINE_CAP = 4000   # only the first 4000 characters of a line are tested (minified files made a full scan crawl)

def scan(lines):
    hits, path = Counter(), None
    for raw in lines:
        m = re.match(r"Binary files .* and b/(.*) differ$", raw.rstrip("\n"))   # binary files have no +++ line
        if raw.startswith("+++ ") or m:
            path = m.group(1) if m else raw[4:].strip()
            path = path[2:] if not m and path.startswith("b/") else path
            if path != "/dev/null":
                for name, rx in PATHS.items():
                    if re.search(rx, path):
                        hits[(path, name)] += 1
            continue
        if path in (None, "/dev/null", SELF) or not raw.startswith("+") or raw.startswith("+++"):
            continue
        line = raw[1:LINE_CAP]
        for name, rx in CONTENT.items():
            if re.search(rx, line):
                hits[(path, name)] += 1
    return hits

def self_test():
    fake = "+" + BEGIN + " OPENSSH PRIVATE KEY-----"
    d = ["+++ b/.config/x/conf", fake, "+token = abcd1234efgh5678", "+password=$PASSWORD", "+harmless line",
         "+++ b/.configure/vivaldi/Default/History", "+++ b/.ssh/id_ed25519", "+++ b/tools/secret-scan", fake,
         "Binary files /dev/null and b/.configure/vivaldi/Default/Login Data differ"]
    got = {(p, n) for (p, n) in scan(d)}
    want = {(".config/x/conf", "private key block"), (".config/x/conf", "password/token assignment"),
            (".configure/vivaldi/Default/History", "browser profile data"), (".ssh/id_ed25519", "key or vault file"),
            (".configure/vivaldi/Default/Login Data", "browser profile data")}
    assert got == want, sorted(got ^ want)
    print("secret-scan self-test: ok")

if __name__ == "__main__":
    if sys.argv[1:] == ["--self-test"]:
        self_test(); sys.exit(0)
    sys.stdin.reconfigure(errors="replace")
    for (path, name), n in sorted(scan(sys.stdin).items()):
        print(f"{path}: {name} ({n} line{'s' if n > 1 else ''})")
