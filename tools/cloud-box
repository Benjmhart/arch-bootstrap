#!/usr/bin/env bash
# cloud-box -- a dev box on Hetzner Cloud from the kept arch-cloud image (station-maintenance beast-arch 85).
#
#   cloud-box create NAME [VOLUME]   server NAME from the newest snapshot labelled purpose=arch-cloud, plus the Volume
#                                    VOLUME (default: NAME), re-attached if it exists, else created; both encrypted
#   cloud-box unlock NAME            after a reboot: type NAME's disk passphrase at its initramfs (tools/unlock)
#   cloud-box delete NAME            the server only; its volume and the data on it stay (and stay billed)
#   cloud-box delete-volume VOLUME   the volume and everything on it, for good
#   cloud-box list
#   cloud-box ssh-config [--dry-run] this machine's ~/.ssh/config Host blocks + pinned host keys, from the records
#   cloud-box login-keys             the keys every box lets log in as ben (public; one per line)
#
# Login is by YubiKey touch only (Ben 2026-11-05: "yubikeys only by default, fallback to the existing drive encryption
# and sudo passwords"): plug one in, ssh NAME, touch. sshd takes no passwords. Without a YubiKey: the Hetzner web
# console (Cloud Console > server > Console), log in as ben with the sudo password set at create.
#
# Ben 2026-11-05: "small plan with a 100gb volume". The image's 24 GiB root keeps the OS and the toolchains; /nix and
# ~/projects live on the volume (bind mounts from /mnt/data), so deleting and re-creating the server keeps the nix store
# and the work. Env: HZ_TYPE (cx23), HZ_LOC (nbg1), CLOUD_BOX_VOLUME_GB (100), CLOUD_BOX_PASSWORD_HASH (ben's sudo
# password as a $6$ hash; asked for when unset). Token: ~/.config/hcloud/token-rw. Touches only resources labelled
# purpose=cloud-box, which it creates.
#
# Keys, all from the secrets repo, all public: ssh login AND sudo = the fleet's touch-required YubiKey set of Ben's four
# YubiKeys (bootstrap.sh setup_yubikey: ssh/fleet/micro-peer-* + ssh/unlock/*; never micro-yubikey-nt-*, never a plain
# key), sk- lines only: login_keys(). sudo gets them in /etc/sudo-agent-keys.in; the image keeps only sk- lines for
# pam_rssh. authorized_keys carries no options, so sshd demands the touch flag on every login.
# CLOUD_BOX_EXTRA_LOGIN_KEY=FILE.pub (tests only): one more login key for this box alone (ssh AND its initramfs unlock),
# and create checks with it.
#
# Disk encryption (Ben 2026-11-05: "go ahead with disk encryption"; "fallback to the existing drive encryption and sudo
# passwords"). The snapshot is plain; create encrypts each box in Hetzner's rescue system before its first boot:
# `cryptsetup reencrypt --encrypt` of the root partition (LUKS2, a NEW volume key per box, so boxes from one snapshot
# share no key) and a fresh LUKS2 volume, or, re-attached, the volume's own LUKS with a new keyfile slot. Root is
# unlocked at every boot; the volume then opens by itself (/etc/cryptsetup-keys.d/data.key on the encrypted root,
# volume key slot 1; slot 0 is the passphrase, the way back in without the root). The passphrase is asked for at create
# (stdin when it is not a terminal: tests), sent to the rescue system over ssh, and kept nowhere. To unlock:
#   cloud-box unlock NAME   ssh to the initramfs's own sshd on the box's public address (no tailnet; dracut
#                           90remote-unlock): YubiKey sk keys only, forced command = the passphrase prompt; host key
#                           made here at create and PINNED (record `initramfs-hostkey`, alias NAME-initramfs).
#   touch instead of typing: tools/unlock-touch-enroll NAME (beast-arch or carbon, one YubiKey plugged in; once per key).
#   Hetzner web console:    the passphrase prompt is on its screen (console=tty0 last), typed there.
# Only a volume labelled disk=luks2 (made by this tool since 2026-11-06) is re-attached: a plain one is refused.
# Record: create writes secrets cloud-box/NAME (name, ipv4, server, volume, the box's ssh host keys as seen at create)
# and commits + pushes it; delete removes it. Only that path is committed, never the vault. micro never commits to
# secrets: there the record is printed, to be committed from beast-arch or carbon.
# Client: `ssh-config` writes a `# >>> cloud-box NAME` Host block per record into ~/.ssh/config (and removes blocks
# whose record is gone), with every YubiKey handle on this machine (~/.ssh/id_ed25519_sk_peer_* on micro,
# id_ed25519_sk_unlock_* from tools/unlock-key on beast-arch and carbon: whichever key is plugged works) and, where this machine runs the fleet's sudo agent, ForwardAgent of THAT
# agent only (sk keys), as ssh_tailnet_peers does for peers -- never the main agent; host keys PINNED in
# ~/.ssh/known_hosts.cloud-box from the records (StrictHostKeyChecking yes). create and delete run it; so does
# bootstrap.sh stage services (fpush) on CLOUD_BOX_CLIENTS (beast-arch carbon micro). Ben 2026-11-05.
set -euo pipefail
S=${SECRETS_DIR:-$HOME/secrets} rec=${SECRETS_DIR:-$HOME/secrets}/cloud-box
type=${HZ_TYPE:-cx23} loc=${HZ_LOC:-nbg1} gb=${CLOUD_BOX_VOLUME_GB:-100}
cfg=$HOME/.ssh/config kh=$HOME/.ssh/known_hosts.cloud-box here=$(dirname "$(readlink -f "$0")")
# THE login (and sudo) key set of every box: touch-required YubiKey sk keys only. Fails if there are none.
login_keys() {
  local f out=""
  for f in "$S"/ssh/fleet/micro-peer-*.pub "$S"/ssh/unlock/*.pub; do
    [[ -f $f ]] || continue
    if grep -qE '^sk-(ssh-ed25519|ecdsa-sha2-nistp256)@openssh\.com [A-Za-z0-9+/=]+( |$)' "$f"; then out+=$(head -1 "$f")$'\n'
    else echo "cloud-box: left out (not an sk- key): ${f#"$S"/}" >&2; fi
  done
  [[ -n $out ]] || { echo "cloud-box: no YubiKey sk keys in $S/ssh/fleet/micro-peer-*.pub or $S/ssh/unlock/*.pub" >&2; return 1; }
  printf '%s' "$out"
}
api() { local m=$1 p=$2 tok; shift 2; tok=$(<"$HOME/.config/hcloud/token-rw")
  curl -sS -X "$m" -H "Authorization: Bearer $tok" -H 'Content-Type: application/json' "https://api.hetzner.cloud/v1/$p" "$@"; }
wait_action() { local s; for _ in $(seq 120); do s=$(api GET "actions/$1" | jq -r .action.status); [[ $s == success ]] && return; [[ $s == error ]] && { api GET "actions/$1" | jq -c .action.error; return 1; }; sleep 3; done; return 1; }
die() { echo "cloud-box: $*" >&2; exit 1; }
ours() { jq -e '.labels.purpose == "cloud-box"' >/dev/null; }
server_json() { api GET "servers?name=$1" | jq -c '.servers[0] // empty'; }
volume_json() { api GET "volumes?name=$1" | jq -c '.volumes[0] // empty'; }
name_ok() { [[ $1 =~ ^[a-z][a-z0-9-]{0,40}$ ]] || die "bad name '$1' (lowercase letters, digits, -)"; }

# Runs as root from cloud-init bootcmd on EVERY boot, before sshd: mount the volume, seed /nix and ~/projects onto it
# the first time, bind them over the image's copies. fstab carries the same mounts from the next boot on, ahead of
# nix-daemon.socket (nofail: a missing volume leaves the image's own /nix). Only --no-block systemctl calls here: a
# blocking one could wait on boot ordering that waits on cloud-init.
# shellcheck disable=SC2016
volume_sh='set -eu
dev=$1 d=/mnt/data
for _ in $(seq 60); do [ -e "$dev" ] && break; sleep 1; done
[ -e "$dev" ] || { echo "cloud-box: no volume at $dev -- /nix and ~/projects stay on the root fs"; exit 0; }
grep -q "^$dev " /etc/fstab || printf "%s\n" "$dev $d ext4 defaults,nofail,discard 0 2" \
  "$d/nix /nix none bind,nofail,x-systemd.requires-mounts-for=$d 0 0" \
  "$d/projects /home/ben/projects none bind,nofail,x-systemd.requires-mounts-for=$d 0 0" >> /etc/fstab
mkdir -p $d; mountpoint -q $d || mount $d
if [ ! -d $d/nix ]; then
  systemctl --no-block stop nix-daemon.socket nix-daemon.service 2>/dev/null || true
  rm -rf $d/nix.new; cp -a /nix $d/nix.new; mv $d/nix.new $d/nix
fi
[ -d $d/projects ] || { rm -rf $d/projects.new; cp -a /home/ben/projects $d/projects.new; mv $d/projects.new $d/projects; }
mountpoint -q /home/ben/projects || mount /home/ben/projects
chown ben:ben /home/ben/projects
if ! mountpoint -q /nix; then
  mount /nix; chown root:nixbld /nix/store; chmod 1775 /nix/store
  # nix-daemon.socket may already listen in the image /nix, now hidden: clients got "Connection refused" (2026-11-05).
  systemctl --no-block stop nix-daemon.service 2>/dev/null || true; systemctl --no-block restart nix-daemon.socket
fi'

field() { awk -v k="$1" '$1 == k {print $2; exit}' "$2"; }

# ~/.ssh/config: every `# >>> cloud-box` block out, one per record in (at the end); $kh: exactly the records' host keys.
# Extra arguments are record files counted for this run only (micro's, before it is in secrets).
ssh_config() {
  local dry=0 f n ip k ik blocks="" keys="" names=() old cur rest want ids=""
  for f in "$HOME"/.ssh/id_ed25519_sk_peer_* "$HOME"/.ssh/id_ed25519_sk_unlock_*; do
    [[ -f $f && $f != *.pub ]] && ids+="    IdentityFile ~/.ssh/${f##*/}"$'\n'; done
  [[ ${1:-} == --dry-run ]] && { dry=1; shift; }
  for f in "$rec"/* "$@"; do
    [[ -f $f ]] || continue
    n=$(field name "$f"); ip=$(field ipv4 "$f")
    k=$(awk -v a="cloud-box-$n" '$1 == "hostkey" && $2 ~ /^(ssh-ed25519|ecdsa-sha2-nistp[0-9]+|ssh-rsa)$/ && $3 ~ /^[A-Za-z0-9+\/=]+$/ {print a, $2, $3}' "$f")
    if [[ ! $n =~ ^[a-z][a-z0-9-]{0,40}$ || ! $ip =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ || -z $k ]]; then
      echo "cloud-box: skipped $f: needs name, ipv4 and at least one hostkey" >&2; continue; fi
    [[ " ${names[*]} " == *" $n "* ]] && continue
    # The initramfs's own sshd (disk unlock), same address, its own pinned key: Host NAME-initramfs.
    ik=$(awk -v a="cloud-box-$n-initramfs" '$1 == "initramfs-hostkey" && $2 == "ssh-ed25519" && $3 ~ /^[A-Za-z0-9+\/=]+$/ {print a, $2, $3; exit}' "$f")
    names+=("$n") keys+=$k$'\n'; [[ -n $ik ]] && keys+=$ik$'\n'
    blocks+="# >>> cloud-box $n (arch-bootstrap tools/cloud-box, from secrets cloud-box/$n)
Host $n
    HostName $ip
    User ben
    HostKeyAlias cloud-box-$n
    UserKnownHostsFile $kh
    StrictHostKeyChecking yes
${ids:-    # no YubiKey handle here (~/.ssh/id_ed25519_sk_*): tools/unlock-key makes one
}    IdentitiesOnly yes
"
    # shellcheck disable=SC2016
    [[ -f $HOME/.config/systemd/user/ssh-sudo-agent.service ]] && blocks+='    ForwardAgent ${XDG_RUNTIME_DIR}/ssh-sudo-agent.sock'$'\n'
    [[ -n $ik ]] && blocks+="Host $n-initramfs
    HostName $ip
    User root
    HostKeyAlias cloud-box-$n-initramfs
    UserKnownHostsFile $kh
    StrictHostKeyChecking yes
${ids}    IdentitiesOnly yes
    ForwardAgent no
    RequestTTY yes
"
    blocks+="# <<< cloud-box $n"$'\n'
  done
  [[ $(grep -c '^# >>> cloud-box ' "$cfg" 2>/dev/null) == "$(grep -c '^# <<< cloud-box ' "$cfg" 2>/dev/null)" ]] \
    || die "$cfg has a cloud-box start marker without its end (or the reverse): fix it by hand; nothing written"
  old=$(sed -n 's/^# >>> cloud-box \([^ ]*\) .*/\1/p' "$cfg" 2>/dev/null | paste -sd' ' || true)
  cur=$(cat "$cfg" 2>/dev/null || true)
  rest=$(sed '/^# >>> cloud-box /,/^# <<< cloud-box /d' "$cfg" 2>/dev/null || true)
  want=$rest; [[ -n $rest && -n $blocks ]] && want+=$'\n'; want+=${blocks%$'\n'}
  if [[ $cur == "$want" && "$(cat "$kh" 2>/dev/null || true)" == "${keys%$'\n'}" ]]; then
    echo "up to date: ssh config for cloud boxes: ${names[*]:-none}"; return 0; fi
  if (( dry )); then echo "would write ssh config for cloud boxes: ${names[*]:-none} (now: ${old:-none})"; return 0; fi
  mkdir -p "${cfg%/*}"; f=$(mktemp "$cfg.XXXXXX"); printf '%s\n' "$want" > "$f"; chmod 600 "$f"; mv "$f" "$cfg"
  if [[ -n $keys ]]; then printf '%s' "$keys" > "$kh"; chmod 644 "$kh"; else rm -f "$kh"; fi
  echo "wrote ssh config for cloud boxes: ${names[*]:-none} (was: ${old:-none})"
}

# Commit and push secrets cloud-box/NAME as it now is in the work tree (written, or removed): that path only.
record_commit() {
  git -C "$S" add -A -- "cloud-box/$1"
  git -C "$S" diff --cached --quiet -- "cloud-box/$1" && return 0
  git -C "$S" commit -q -m "$2" -- "cloud-box/$1" || { echo "WARN: could not commit cloud-box/$1 in $S"; return 0; }
  git -C "$S" push -q || echo "WARN: secrets not pushed (cloud-box/$1 is committed): push it by hand, never --force"
  echo "secrets: $(git -C "$S" log -1 --format='%h %s')"
}

cost() {   # monthly gross EUR, from the API
  api GET pricing | jq -r --arg t "$type" --arg l "$loc" --argjson gb "$gb" '.pricing as $p
    | ($p.server_types[] | select(.name == $t) | .prices[] | select(.location == $l) | .price_monthly.gross | tonumber) as $s
    | ($p.volume.price_per_gb_month.gross | tonumber) as $v
    | "cost: server \($t) \($l) \($s*100|round/100) EUR/month (billed hourly while it exists, running or not); volume \($gb) GB \($v*$gb*100|round/100) EUR/month until deleted (\($p.currency), gross)"'
}

# Runs as root in Hetzner's rescue system (Debian, RAM only), from create, before the box's first boot. Inputs in
# /root/cb (0700): pass (the disk passphrase, no newline), volpass (the volume's), ssh_host_ed25519_key, authorized_keys,
# sshd_config (test boxes only). $1 = the volume's device, $2 = new|reattach. Exit 3: the volume passphrase is wrong.
# The volume goes first: when it cannot be opened, nothing has been changed yet.
# shellcheck disable=SC2016
rescue_sh='set -euo pipefail
in=/root/cb vol=$1 mode=$2 m=/mnt/cb
trap "echo rescue: FAILED at line \$LINENO" ERR
for c in cryptsetup sfdisk partx resize2fs e2fsck blkid chroot; do command -v $c >/dev/null || { echo "rescue: no $c"; exit 1; }; done
echo "rescue: $(cryptsetup --version)"
root=$(blkid -L root) boot=$(blkid -L boot)
disk=/dev/$(lsblk -no PKNAME "$root") part=$(cat "/sys/class/block/${root#/dev/}/partition")
[ "$(blkid -o value -s TYPE "$root")" = ext4 ] || { echo "rescue: $root is not the plain ext4 root of the image"; exit 1; }
for _ in $(seq 30); do [ -e "$vol" ] && break; sleep 1; done
key=$in/data.key; head -c 64 /dev/urandom > "$key"
if [ "$mode" = new ]; then
  cryptsetup luksFormat -q --type luks2 --label cloud-box-data --key-file "$in/pass" "$vol"
  cryptsetup luksAddKey -q --key-file "$in/pass" -S 1 "$vol" "$key"
  cryptsetup open --key-file "$key" "$vol" cbdata; mkfs.ext4 -q -L data /dev/mapper/cbdata; cryptsetup close cbdata
  echo "rescue: volume encrypted (LUKS2; slot 0 passphrase, slot 1 this box)"
else
  [ "$(blkid -o value -s TYPE "$vol")" = crypto_LUKS ] || { echo "rescue: the volume is not LUKS"; exit 1; }
  s=$(cryptsetup open --test-passphrase -v --key-file "$in/volpass" "$vol" 2>&1 | sed -n "s/^Key slot \([0-9]*\) unlocked.*/\1/p" || true)
  [ -n "$s" ] || { echo "rescue: that passphrase does not open the volume"; exit 3; }
  [ "$s" != 1 ] || { echo "rescue: the passphrase is in slot 1, where the box keyfile goes; not touching it"; exit 1; }
  # Slot 1 held the old box keyfile, which went with that box root disk.
  cryptsetup luksKillSlot -q --key-file "$in/volpass" "$vol" 1 2>/dev/null || true
  cryptsetup luksAddKey -q --key-file "$in/volpass" -S 1 "$vol" "$key"
  echo "rescue: volume re-attached (its passphrase opened slot $s; slot 1 is now this box)"
fi
echo "rescue: encrypting $root ($(( $(blockdev --getsize64 "$root") >> 20 )) MiB) in place"
e2fsck -fp "$root" || [ $? -le 1 ]
resize2fs "$root" "$(( $(blockdev --getsize64 "$root") / 1024 - 32768 ))K"
cryptsetup reencrypt -q --encrypt --type luks2 --label cloud-box-root --reduce-device-size 32M --key-file "$in/pass" "$root"
# The image is 24 GiB; the disk is bigger. Grown here, not by cloud-init (user-data turns growpart off).
sfdisk -q --relocate gpt-bak-std "$disk"; echo ", +" | sfdisk -q --no-reread -N "$part" "$disk"; partx -u "$disk"
cryptsetup open --key-file "$in/pass" "$root" root; resize2fs /dev/mapper/root
luuid=$(cryptsetup luksUUID "$root") vuuid=$(cryptsetup luksUUID "$vol")
mkdir -p $m; mount /dev/mapper/root $m; mount "$boot" $m/boot
install -d -m 700 $m/etc/cryptsetup-keys.d $m/etc/remote-unlock
install -m 600 "$key" $m/etc/cryptsetup-keys.d/data.key
touch $m/etc/crypttab; sed -i "/^data /d" $m/etc/crypttab; echo "data UUID=$vuuid /etc/cryptsetup-keys.d/data.key luks,discard,nofail" >> $m/etc/crypttab
for f in ssh_host_ed25519_key authorized_keys sshd_config; do [ ! -e "$in/$f" ] || install -m 600 "$in/$f" "$m/etc/remote-unlock/$f"; done
echo "add_dracutmodules+=\" remote-unlock \"" > $m/etc/dracut.conf.d/remote-unlock.conf
# tty0 LAST: /dev/console, where systemd asks for the passphrase, is then the screen of the Hetzner web console.
sed -i -e "s|^GRUB_CMDLINE_LINUX=.*|GRUB_CMDLINE_LINUX=\"rd.luks.name=$luuid=root rd.luks.options=discard\"|" \
  -e "s|^GRUB_CMDLINE_LINUX_DEFAULT=.*|GRUB_CMDLINE_LINUX_DEFAULT=\"console=ttyS0,115200 console=tty0\"|" $m/etc/default/grub
for d in dev proc sys run; do mount --rbind /$d $m/$d; mount --make-rslave $m/$d; done
kver=$(ls $m/usr/lib/modules | sort -V | tail -n1)
chroot $m dracut -q --force /boot/initramfs-linux.img --kver "$kver"
chroot $m grub-mkconfig -o /boot/grub/grub.cfg 2>&1 | grep -iE "error|warn" || true
grep -q "rd.luks.name=$luuid=root" $m/boot/grub/grub.cfg
l=$(chroot $m lsinitrd /boot/initramfs-linux.img)
{ grep -q "usr/bin/unlock-prompt$" <<<"$l" && grep -q "root/.ssh/authorized_keys$" <<<"$l" && ! grep -q "usr/bin/tailscaled$" <<<"$l"; } \
  || { echo "rescue: the new initramfs lacks the unlock sshd (or has tailscale)"; exit 1; }
echo "rescue: initramfs $(du -h $m/boot/initramfs-linux.img | cut -f1) with the unlock sshd, no tailscale; grub.cfg unlocks $luuid"
umount -R $m; rm -rf "$in"; sync; udevadm settle 2>/dev/null || true
# Closing can race with udev ("Device root is still in use", 2026-11-06); it is unmounted and synced either way.
cryptsetup close root 2>/dev/null || { sleep 3; cryptsetup close root; } || echo "rescue: root stays open (unmounted, synced)"
echo "rescue: done"'

ask_pass() {   # PROMPT [confirm]: the passphrase on stdout; from the terminal, or one line of stdin if that is no terminal (tests)
  local a b
  if [[ -t 0 ]]; then
    IFS= read -rsp "$1: " a; echo >&2
    if [[ ${2:-} == confirm ]]; then IFS= read -rsp "again: " b; echo >&2; [[ $a == "$b" ]] || die "the two passphrases differ"; fi
  else IFS= read -r a || true; fi
  printf '%s' "$a"
}

ct="" rkid=""
create_cleanup() { [[ -n $ct ]] && rm -rf "$ct"; [[ -n $rkid ]] && api DELETE "ssh_keys/$rkid" >/dev/null; return 0; }

create() {
  local name=$1 vol=${2:-$1} snap v vid created=0 mode=new login sudo chk hash ud r sid ip dev hk ik out pass volpass rc p
  local extra=${CLOUD_BOX_EXTRA_LOGIN_KEY:-} R
  name_ok "$name"; name_ok "$vol"
  [[ -z $(server_json "$name") ]] || die "a server named $name exists"
  if grep -qx "Host $name" "$cfg" 2>/dev/null && ! grep -q "^# >>> cloud-box $name " "$cfg"; then die "~/.ssh/config already has 'Host $name' -- pick another name"; fi
  if [[ $(uname -n) != micro ]]; then
    git -C "$S" pull -q --ff-only || die "could not fast-forward $S (where the box's record goes); nothing created"
    [[ ! -e $rec/$name ]] || die "secrets has a record cloud-box/$name already: cloud-box delete $name first"
  fi
  # CLOUD_BOX_SNAPSHOT (tests): a snapshot id to use instead of the newest purpose=arch-cloud one.
  snap=${CLOUD_BOX_SNAPSHOT:-$(api GET 'images?type=snapshot&label_selector=purpose%3Darch-cloud&sort=created:desc' | jq -r '.images[0].id // empty')}
  [[ -n $snap ]] || die "no snapshot labelled purpose=arch-cloud"

  sudo=$(login_keys) || die "no YubiKey keys to log in with; nothing created"
  login=$sudo chk=(ssh -o BatchMode=yes -o ConnectTimeout=10 -o ForwardAgent=no)
  echo "login, sudo and disk unlock: $(grep -c . <<<"$sudo") YubiKey sk keys (touch required)"
  if [[ -n $extra ]]; then
    login+=$'\n'$(head -1 "$extra") chk+=(-i "${extra%.pub}")
    echo "TEST: $extra may log in to $name and unlock its disk too (CLOUD_BOX_EXTRA_LOGIN_KEY)"
  fi
  hash=${CLOUD_BOX_PASSWORD_HASH:-}
  [[ -n $hash ]] || { echo "ben's sudo password on $name:"; hash=$(openssl passwd -6); }
  [[ $hash == '$6$'* ]] || die "CLOUD_BOX_PASSWORD_HASH is not a \$6\$ hash"

  v=$(volume_json "$vol")
  if [[ -n $v ]]; then
    ours <<<"$v" || die "volume $vol exists but is not labelled purpose=cloud-box -- not touching it"
    [[ $(jq -r .labels.disk <<<"$v") == luks2 ]] \
      || die "volume $vol is not encrypted (no label disk=luks2: made before 2026-11-06), and an encrypted box does not take a plain volume. Copy its data off and delete it (cloud-box delete-volume $vol), or give another VOLUME"
    [[ $(jq -r .location.name <<<"$v") == "$loc" ]] || die "volume $vol is in $(jq -r .location.name <<<"$v"), not $loc (HZ_LOC)"
    [[ $(jq -r .server <<<"$v") == null ]] || die "volume $vol is attached to server $(jq -r .server <<<"$v")"
    mode=reattach
  fi
  # The passphrases, before anything is made. Kept in memory and, for the rescue system, in a 0700 dir on tmpfs.
  pass=$(ask_pass "disk passphrase for $name (typed at each boot, here or in the web console)" confirm)
  (( ${#pass} >= 8 )) || die "the disk passphrase must have 8 characters or more; nothing created"
  volpass=$pass
  if [[ $mode == reattach ]]; then p=$(ask_pass "passphrase of the volume $vol (Enter: the same)"); [[ -z $p ]] || volpass=$p; fi

  if [[ $mode == reattach ]]; then
    vid=$(jq -r .id <<<"$v"); echo "re-attaching encrypted volume $vol ($vid, $(jq -r .size <<<"$v") GB)"
  else
    r=$(api POST volumes -d "$(jq -n --arg n "$vol" --arg l "$loc" --argjson s "$gb" '{name:$n,size:$s,location:$l,labels:{purpose:"cloud-box",disk:"luks2"}}')")
    vid=$(jq -r '.volume.id // empty' <<<"$r"); [[ -n $vid ]] || die "volume create: $(jq -c .error <<<"$r")"
    wait_action "$(jq -r .action.id <<<"$r")"; created=1; echo "created volume $vol ($vid, $gb GB; encrypted in the rescue system)"
  fi
  dev=$(api GET "volumes/$vid" | jq -r .volume.linux_device)

  trap create_cleanup EXIT
  ct=$(umask 077; mktemp -d -p "${XDG_RUNTIME_DIR:-/tmp}"); mkdir -m 700 "$ct/in"
  printf '%s' "$pass" > "$ct/in/pass"; printf '%s' "$volpass" > "$ct/in/volpass"
  # The initramfs host key is made HERE, so the client pins it before the box ever boots (no trust on first use).
  ssh-keygen -q -t ed25519 -N '' -C "$name-initramfs" -f "$ct/in/ssh_host_ed25519_key"
  ik=$(cut -d' ' -f1-2 "$ct/in/ssh_host_ed25519_key.pub"); rm "$ct/in/ssh_host_ed25519_key.pub"
  # As bootstrap.sh setup_remote_unlock: touch required (no no-touch-required option), the prompt is all they can run.
  sed 's|^|restrict,pty,command="/usr/bin/unlock-prompt" |' <<<"$(cut -d' ' -f1-2 <<<"$login")" > "$ct/in/authorized_keys"
  if [[ -n $extra ]]; then   # a test box: its initramfs also takes the plain test key (sshd takes sk keys only otherwise)
    sed 's/^PubkeyAcceptedAlgorithms .*/&,ssh-ed25519/' "$here/../dracut/90remote-unlock/sshd_config" > "$ct/in/sshd_config"
  fi
  ssh-keygen -q -t ed25519 -N '' -C "cloud-box-rescue-$name" -f "$ct/rk"
  rkid=$(api POST ssh_keys -d "$(jq -n --arg n "cloud-box-rescue-$name" --arg k "$(cat "$ct/rk.pub")" '{name:$n,public_key:$k,labels:{purpose:"cloud-box"}}')" | jq -r '.ssh_key.id // empty')
  [[ -n $rkid ]] || die "could not add the temporary rescue ssh key"

  ud="#cloud-config"$'\n'$(jq -n --arg h "$name" --arg login "$login" --arg pw "$hash" --arg sudo "$sudo" --arg sh "$volume_sh" '{
    hostname: $h,
    ssh_authorized_keys: ($login | split("\n") | map(select(length > 0))),
    chpasswd: {expire: false, users: [{name: "ben", type: "hash", password: $pw}]},
    write_files: [{path: "/etc/sudo-agent-keys.in", permissions: "0644", owner: "root:root", content: $sudo}],
    growpart: {mode: "off"}, resize_rootfs: false,
    bootcmd: [["sh", "-c", $sh, "cloud-box", "/dev/mapper/data"]]}')
  r=$(api POST servers -d "$(jq -n --arg n "$name" --arg t "$type" --arg l "$loc" --argjson i "$snap" --arg u "$ud" --argjson v "$vid" \
    '{name:$n,server_type:$t,location:$l,image:$i,user_data:$u,volumes:[$v],automount:false,start_after_create:false,labels:{purpose:"cloud-box"}}')")
  sid=$(jq -r '.server.id // empty' <<<"$r")
  [[ -n $sid ]] || { (( created )) && echo "the new volume $vol stays: cloud-box delete-volume $vol"; die "server create: $(jq -c .error <<<"$r")"; }
  wait_action "$(jq -r .action.id <<<"$r")"
  ip=$(api GET "servers/$sid" | jq -r .server.public_net.ipv4.ip)
  echo "server $name ($sid, $type $loc) at $ip from snapshot $snap; encrypting it in the rescue system..."
  wait_action "$(api POST "servers/$sid/actions/enable_rescue" -d "{\"type\":\"linux64\",\"ssh_keys\":[$rkid]}" | jq -r .action.id)"
  wait_action "$(api POST "servers/$sid/actions/poweron" | jq -r .action.id)"
  # The rescue system's host key is new on every boot and published nowhere: not checked (it sees the passphrase once).
  R=(ssh -i "$ct/rk" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=5 -o BatchMode=yes -o LogLevel=ERROR "root@$ip")
  for _ in $(seq 60); do "${R[@]}" true </dev/null 2>/dev/null && break; sleep 5; done
  api DELETE "ssh_keys/$rkid" >/dev/null; rkid=""
  tar -C "$ct/in" -c . | "${R[@]}" 'umask 077; rm -rf /root/cb; mkdir /root/cb; tar -x -C /root/cb' \
    || die "could not reach $name's rescue system; server $name ($sid) stays: cloud-box delete $name"
  rm -rf "$ct/in"
  rc=0; "${R[@]}" bash -s -- "$dev" "$mode" <<<"$rescue_sh" || rc=$?
  if (( rc )); then
    (( rc == 3 )) && echo "the passphrase given for the volume $vol does not open it"
    die "encrypting $name failed (rescue rc $rc); server $name ($sid) stays in the rescue system: cloud-box delete $name"
  fi
  # Nothing is mounted in the rescue system now: a power cycle is safe, and boots the disk (rescue is one boot only).
  wait_action "$(api POST "servers/$sid/actions/poweroff" | jq -r .action.id)"
  wait_action "$(api POST "servers/$sid/actions/poweron" | jq -r .action.id)"
  printf 'cloud-box-%s-initramfs %s\n' "$name" "$ik" > "$ct/kh"
  echo "first boot of $name: unlocking its disk (the passphrase is typed for you)"
  UNLOCK_ADDR=$ip UNLOCK_KNOWN_HOSTS=$ct/kh UNLOCK_DISK=$pass UNLOCK_KEY=${extra%.pub} "$here/unlock" "$name" \
    || echo "WARN: the unlock session ended with an error; checking whether $name came up anyway"
  unset pass volpass

  echo "waiting for $name's own ssh host keys..."
  # The host keys as seen now, pinned from here on (cloud-init makes them before sshd starts; checked again below).
  # The initramfs's key is not one of them: it may still answer for a moment after the unlock.
  hk=""; for _ in $(seq 60); do hk=$(ssh-keyscan -T 5 "$ip" 2>/dev/null | awk '$1 !~ /^#/ && NF == 3 {print "hostkey", $2, $3}' | sort -u | grep -vxF "hostkey $ik" || true); [[ -n $hk ]] && break; sleep 5; done
  [[ -n $hk ]] || die "no ssh host key from $ip in 5 min (still at its disk prompt? cloud-box unlock needs its record); server $name ($sid) and volume $vol stay: cloud-box delete $name"
  out=$rec/$name; [[ $(uname -n) == micro ]] && out=$(mktemp)
  mkdir -p "${out%/*}"
  printf '%s\n' "# cloud-box record (arch-bootstrap tools/cloud-box). bootstrap.sh stage services writes ~/.ssh/config from it." \
    "name $name" "ipv4 $ip" "server $sid" "volume $vol" "created $(date -u +%FT%TZ) on $(uname -n)" "$hk" "initramfs-hostkey $ik" > "$out"
  if [[ $(uname -n) == micro ]]; then
    echo "micro never commits to secrets: commit this as secrets cloud-box/$name from beast-arch or carbon (until then only this machine knows the box, and the next fpush here drops its block):"
    sed 's/^/    /' "$out"
  else
    record_commit "$name" "cloud-box/$name: server $sid at $ip, volume $vol (arch-bootstrap tools/cloud-box create on $(uname -n))"
  fi
  ssh_config "$([[ $out == "$rec/$name" ]] || echo "$out")"
  # sshd answered the keyscan, so cloud-init has put the keys in: one login, one touch (a few tries in case it is slow).
  echo "checking $name over ssh: touch your YubiKey when it blinks"
  for _ in 1 2 3; do "${chk[@]}" "$name" 'cloud-init status --wait >/dev/null; findmnt -no SOURCE,TARGET /; findmnt -no SOURCE,TARGET /nix; findmnt -no SOURCE,TARGET ~/projects' </dev/null && break
    echo "WARN: ssh $name failed (no YubiKey plugged in, or no touch?)"; sleep 5; done
  [[ $(ssh-keyscan -T 5 "$ip" 2>/dev/null | awk '$1 !~ /^#/ && NF == 3 {print "hostkey", $2, $3}' | sort -u || true) == "$hk" ]] \
    || echo "WARN: $name's host keys changed after create: the pinned ones are wrong; cloud-box delete $name and create again"
  cost || true
  echo "created: server $name ($sid)$( (( created )) && echo ", volume $vol ($vid)"), root and volume encrypted (LUKS2)"
  echo "use:     ssh $name"
  echo "reboot:  cloud-box unlock $name    (or type the passphrase in the Hetzner web console)"
  echo "touch:   tools/unlock-touch-enroll $name   (beast-arch or carbon, one YubiKey plugged in; once per YubiKey)"
  echo "delete:  cloud-box delete $name          (server only; volume $vol and its data stay, billed)"
  echo "         cloud-box delete-volume $vol    (the data, for good)"
}

delete() {
  local name=$1 s; name_ok "$name"
  s=$(server_json "$name"); [[ -n $s ]] || die "no server named $name"
  ours <<<"$s" || die "server $name is not labelled purpose=cloud-box -- not touching it"
  # Shut down first: a delete is a power cut, and writes still in the page cache never reach the volume. Deleting
  # right after writing left a 0-byte file in ~/projects and 0-byte nix store files the nix db called valid (2026-11-05).
  local id st ik ip; id=$(jq -r .id <<<"$s") ip=$(jq -r .public_net.ipv4.ip <<<"$s")
  # Waiting at its disk prompt (its initramfs answers ssh, with the key pinned at create): nothing is mounted, and the
  # initramfs does not act on the ACPI shutdown, so a power-off is safe and the only way.
  ik=$(awk '$1 == "initramfs-hostkey" {print $2, $3; exit}' "$rec/$name" 2>/dev/null || true)
  if [[ -n $ik && $(jq -r .status <<<"$s") == running && $(ssh-keyscan -T 5 -t ed25519 "$ip" 2>/dev/null | awk '$1 !~ /^#/ {print $2, $3}') == "$ik" ]]; then
    echo "$name waits at its disk prompt (nothing mounted): powering it off"
    wait_action "$(api POST "servers/$id/actions/poweroff" | jq -r .action.id)"; s=$(api GET "servers/$id" | jq -c .server)
  fi
  if [[ $(jq -r .status <<<"$s") != off ]]; then
    echo "shutting down $name..."; api POST "servers/$id/actions/shutdown" >/dev/null
    for _ in $(seq 60); do st=$(api GET "servers/$id" | jq -r .server.status); [[ $st == off ]] && break; sleep 3; done
    [[ $st == off ]] || die "$name did not shut down within 3 min (status $st); not deleted, so the volume's data is safe -- retry, or shut it down from inside"
  fi
  wait_action "$(api DELETE "servers/$id" | jq -r .action.id)"
  echo "deleted server $name ($id)"
  if [[ -e $rec/$name ]]; then
    if [[ $(uname -n) == micro ]]; then echo "micro never commits to secrets: remove secrets cloud-box/$name from beast-arch or carbon"
    else git -C "$S" pull -q --ff-only || echo "WARN: could not fast-forward $S"
      rm -f "$rec/$name"; record_commit "$name" "cloud-box/$name: deleted, server $id (arch-bootstrap tools/cloud-box delete on $(uname -n))"; fi
  fi
  ssh_config
  jq -r '.volumes[]' <<<"$s" | while read -r v; do
    echo "volume $(api GET "volumes/$v" | jq -r .volume.name) ($v) kept, billed; delete it with: cloud-box delete-volume $(api GET "volumes/$v" | jq -r .volume.name)"; done
}

delete_volume() {
  local v; name_ok "$1"
  v=$(volume_json "$1"); [[ -n $v ]] || die "no volume named $1"
  ours <<<"$v" || die "volume $1 is not labelled purpose=cloud-box -- not touching it"
  [[ $(jq -r .server <<<"$v") == null ]] || die "volume $1 is attached to server $(jq -r .server <<<"$v"): cloud-box delete that server first"
  api DELETE "volumes/$(jq -r .id <<<"$v")" | jq -e '.error' >/dev/null && die "delete failed"
  echo "deleted volume $1 ($(jq -r .id <<<"$v"))"
}

list() {
  api GET 'servers?label_selector=purpose%3Dcloud-box' | jq -r '.servers[] | "server \(.name) \(.id) \(.status) \(.server_type.name) \(.public_net.ipv4.ip) volumes=\(.volumes)"'
  api GET 'volumes?label_selector=purpose%3Dcloud-box' | jq -r '.volumes[] | "volume \(.name) \(.id) \(.size)GB \(.location.name) server=\(.server)"'
}

case ${1:-} in
  create) create "${2:?usage: cloud-box create NAME [VOLUME]}" "${3:-}" ;;
  unlock) exec "$here/unlock" "${2:?usage: cloud-box unlock NAME}" ;;
  delete) delete "${2:?usage: cloud-box delete NAME}" ;;
  delete-volume) delete_volume "${2:?usage: cloud-box delete-volume VOLUME}" ;;
  list) list ;;
  ssh-config) shift; ssh_config "$@" ;;
  login-keys) login_keys ;;
  *) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
