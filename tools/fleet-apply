#!/usr/bin/env bash
# fleet-apply -- the per-machine half of a fleet update driven from micro (tools/fleet;
# station-maintenance beast-arch task 80). It is the forced command of micro's fleet key in
# each machine's authorized_keys, so that key can run this and nothing else. On micro itself
# tools/fleet runs it directly.
#
# Trust model (Ben, 2026-10-08): beast-arch, carbon and media-center are "dirty" -- a compromise
# may happen there, and each can push to GitHub. micro is the trusted place. So a machine never
# applies "whatever is on GitHub": it applies a SNAPSHOT -- one commit per repo -- that Ben
# reviewed on micro. A git commit id names its whole tree and history, so a commit pushed after
# the review, or one Ben excluded, cannot ride along.
#
# Requests (SSH_ORIGINAL_COMMAND over ssh, else the arguments):
#   status                         the last applied line: "<ab> <dot> <sec> <time> rc=<n> stages=..."
#   secrets-push                   phase 1 of a push: hand this machine's own secrets commits to
#                                  origin, so the review sees them. Never pulls. beast-arch is the
#                                  source of truth for the KeePassXC vault, whose merges are
#                                  destructive, so nothing is ever merged:
#                                    vault saved, not committed, on beast-arch -> committed, pushed
#                                    ahead -> pushed; a vault commit off beast-arch is an error
#                                    diverged -> rebased + pushed only if origin left the vault
#                                      alone and nothing conflicts (a conflict aborts); else error
#                                    any other uncommitted change -> error
#                                  Exit 1 = out of sync: the push skips this machine.
#   apply <ab> <dot> <sec> [stage ...|keys]
#                                  move arch-bootstrap, the dotfiles and secrets to exactly those
#                                  commits (each must be on its origin branch), install
#                                  authorized_keys from that secrets commit, then run the stages
#                                  ("keys": only the moves and the keys -- an urgent revocation).
#                                  Forward moves fast-forward the branch; an OLDER commit (a
#                                  rollback) is checked out detached. Secrets only ever move forward:
#                                  rolling the vault back would lose passwords.
#
# For apply, the FIRST LINE OF STDIN is the shared sudo password. It is handed to `sudo -S -v`
# on fd 3 inside a private pty (script), so sudo caches it for that pty and every sudo the
# bootstrap runs there uses the ticket. It never goes to disk, argv or the environment. Prompts
# inside the run read EOF and take their default (no): nothing unattended answers "yes".
#
# Stages are limited to ALLOWED. ~/.config/fleet/hold, per machine:
#   <stage>: <reason>                       skip that stage, and say why
#   ignore-pkgs: <pkg>[,<pkg>] -- <reason>  keep those packages from upgrading (PACMAN_IGNORE): for
#                                           a short local hold; a lasting one goes in arch-bootstrap's
#                                           `holds` file, where it is reviewed and versioned
set -euo pipefail
umask 077
REPO=${FLEET_REPO:-$HOME/projects/arch-bootstrap}
STATE=${FLEET_STATE:-$HOME/.local/state/fleet}
HOLD=${FLEET_HOLD:-$HOME/.config/fleet/hold}
DOTDIR=${FLEET_DOTDIR:-$HOME/.dot}
SECRETS=${FLEET_SECRETS:-$HOME/secrets}
VAULT=Passwords.kdbx
VAULT_HOST=${FLEET_VAULT_HOST:-beast-arch}
HOST=${FLEET_HOST:-$(uname -n)}
ALLOWED="packages aur toolchains services xmonad verify"
DEFAULT="packages aur services xmonad verify"
die() { echo "FAIL  $*"; exit 1; }
touches() { [[ $'\n'$1$'\n' == *$'\n'"$VAULT"$'\n'* ]]; }   # a file list names the vault

secrets_push() {
  local g=(git -C "$SECRETS") ahead behind dirty incoming outgoing
  [[ -d $SECRETS/.git ]] || die "secrets: no checkout at $SECRETS"
  "${g[@]}" fetch -q origin || die "secrets: fetch failed"
  dirty=$("${g[@]}" status --porcelain | awk '{print $2}')
  if [[ -n $dirty && $HOST == "$VAULT_HOST" && $dirty == "$VAULT" ]]; then
    "${g[@]}" commit -q -m "$VAULT: saved $(date -r "$SECRETS/$VAULT" '+%F %H:%M') on $HOST" -- "$VAULT" \
      || die "secrets: could not commit the saved vault on $HOST"
    echo "did   secrets: committed the saved $VAULT on $HOST"
  elif [[ -n $dirty ]]; then
    die "secrets: uncommitted changes on $HOST: $(tr '\n' ' ' <<<"$dirty")-- commit them (the vault only on $VAULT_HOST) or discard"
  fi
  ahead=$("${g[@]}" rev-list --count '@{u}..HEAD'); behind=$("${g[@]}" rev-list --count 'HEAD..@{u}')
  incoming=$("${g[@]}" diff --name-only 'HEAD...@{u}'); outgoing=$("${g[@]}" diff --name-only '@{u}...HEAD')
  if (( ahead )) && [[ $HOST != "$VAULT_HOST" ]] && touches "$outgoing"; then
    die "secrets: $HOST has unpushed $VAULT commits -- the vault's source of truth is $VAULT_HOST; redo the change there"
  fi
  if (( ahead && behind )); then
    touches "$incoming" && die "secrets: diverged on $HOST ($ahead ahead, $behind behind) and origin changed $VAULT -- the vault is never merged; sort it out by hand"
    "${g[@]}" rebase -q '@{u}' >/dev/null 2>&1 || { "${g[@]}" rebase --abort 2>/dev/null
      die "secrets: diverged on $HOST ($ahead ahead, $behind behind) and the rebase conflicts -- nothing changed; sort it out by hand"; }
    echo "did   secrets: rebased $ahead local commit(s) onto origin on $HOST"
  fi
  if (( ahead )); then
    "${g[@]}" push -q origin HEAD || die "secrets: push failed on $HOST"
    echo "did   secrets: pushed $ahead commit(s) from $HOST"
  else
    echo "ok    secrets: nothing to push from $HOST"
  fi
}

# json_ok <file...>: every .json among them parses and repeats no key in any object (two edits that each add the same
# key in different places merge cleanly as text, and a reader then silently keeps only the last one).
json_ok() {
  local f
  for f; do
    [[ $f == *.json && -f $f ]] || continue
    python3 -c 'import json, sys
def once(pairs):
    keys = [k for k, _ in pairs]
    if len(keys) != len(set(keys)): raise ValueError("repeated key")
    return dict(pairs)
json.load(open(sys.argv[1]), object_pairs_hook=once)' "$f" 2>/dev/null || return 1
  done
}

# move <label> <branch> <sha> <forward-only 0|1> <git cmd...>: put a checkout at exactly <sha>,
# which must be on origin/<branch>. Forward: fast-forward the branch (detached if the branch has
# other commits). Older (a rollback): detached, unless forward-only.
move() {
  local label=$1 branch=$2 sha=$3 fwd_only=$4; shift 4
  local g=("$@") cur
  "${g[@]}" fetch -q origin || die "$label: fetch failed"
  "${g[@]}" cat-file -e "$sha^{commit}" 2>/dev/null || die "$label: unknown commit $sha"
  "${g[@]}" merge-base --is-ancestor "$sha" "origin/$branch" || die "$label: ${sha:0:7} is not on origin/$branch"
  cur=$("${g[@]}" rev-parse HEAD)
  # Local commits that are only copies of commits the snapshot already has (the same change pushed rebased, so another
  # SHA: media-center's dotfiles b91723e = 1fc5e55, which stopped the 2026-10-24 20:17 fpush): `git cherry` marks each
  # one "-". Nothing is lost by leaving them, so move as if forward. Any commit of its own ("+") still stops it below.
  local dup=0
  if ! "${g[@]}" merge-base --is-ancestor "$cur" "$sha" && ! "${g[@]}" merge-base --is-ancestor "$sha" "$cur" \
     && [[ -n $("${g[@]}" cherry "$sha" "$cur") && -z $("${g[@]}" cherry "$sha" "$cur" | grep '^+' || true) ]]; then
    dup=1; echo "note  $label: ${cur:0:7}'s local commits are all already in ${sha:0:7} (rebased copies); moving past them"
  fi
  if (( dup )) || "${g[@]}" merge-base --is-ancestor "$cur" "$sha"; then
    # A tracked file changed here in exactly the way the snapshot changes it (KeePassXC rewrites its browser manifests
    # at every start; dotfiles 52fef68 then committed that content): git refuses to fast-forward over it although
    # nothing would be lost, which failed a whole fpush on 2026-10-17. Put such files back first; a file changed in
    # any OTHER way still stops the move below.
    # Also safe (surfboard, 2026-10-24): a file changed here exactly as ONE incoming commit changes it (a fix made live,
    # then committed elsewhere: its xmonad.hs = cbd4f9a, while later commits changed the file again), and an untracked
    # file the snapshot adds with the same content (.local/bin/games copied over before its commit).
    local f pid top; top=$("${g[@]}" rev-parse --show-toplevel)
    while IFS= read -r f; do
      [[ -n $f ]] || continue
      if cmp -s <("${g[@]}" show "$sha:$f" 2>/dev/null) "$top/$f"; then
        "${g[@]}" checkout -q -- ":/$f" && echo "note  $label: $f was already as in ${sha:0:7} here; restored so the move can go on"
        continue
      fi
      pid=$("${g[@]}" diff "$cur" -- ":/$f" | git patch-id --stable | cut -d' ' -f1 || true)
      [[ -n $pid ]] || continue
      while IFS= read -r c; do
        if [[ $("${g[@]}" show "$c" -- ":/$f" | git patch-id --stable | cut -d' ' -f1 || true) == "$pid" ]]; then
          "${g[@]}" checkout -q -- ":/$f" && echo "note  $label: $f was changed here exactly as ${c:0:7} changes it; restored so the move can go on"
          break
        fi
      done < <("${g[@]}" rev-list "$cur..$sha" -- ":/$f")
    done < <("${g[@]}" diff --name-only)
    while IFS= read -r f; do
      [[ -n $f && -f $top/$f ]] && ! "${g[@]}" ls-files --error-unmatch -- ":/$f" >/dev/null 2>&1 \
        && cmp -s <("${g[@]}" show "$sha:$f") "$top/$f" && rm -f -- "$top/$f" \
        && echo "note  $label: untracked $f was already as in ${sha:0:7} here; removed so the move can add it"
    done < <("${g[@]}" diff --name-only --diff-filter=A "$cur" "$sha")
    if [[ $label == secrets ]] && touches "$("${g[@]}" diff --name-only "$cur" "$sha")" && pgrep -x keepassxc >/dev/null; then
      die "secrets: the snapshot changes $VAULT and KeePassXC is running on $HOST -- close it, then re-run"
    fi
    # Dotfiles only: a file edited here that the snapshot ALSO changes (Claude Code rewrites ~/.claude/settings.json on
    # every machine; carbon and media-center stopped the 2026-10-24 17:47 fpush). Set those edits aside, move, then put
    # them back on top. If they do not fit (a conflict, or a .json that no longer parses or repeats a key), the
    # snapshot's version stays and the edits wait in `git stash`, named in the note. Nothing is lost either way.
    local -a clash=() specs=() paths=(); local stashed=0 held=""
    if [[ $label == dotfiles ]]; then
      mapfile -t clash < <(comm -12 <("${g[@]}" diff --name-only | sort) <("${g[@]}" diff --name-only "$cur" "$sha" | sort))
      for f in "${clash[@]}"; do [[ -n $f ]] && specs+=(":/$f") && paths+=("$top/$f"); done
      if (( ${#specs[@]} )); then
        "${g[@]}" stash push -q -m "fleet-apply $(date -Is): local edits before ${sha:0:7}" -- "${specs[@]}" \
          || die "$label: could not set aside local edits to ${clash[*]}"
        stashed=1 held="; the edits to ${clash[*]} are in git stash"
      fi
    fi
    # Ask BEFORE checking the branch out: on media-center (2026-10-24) a stale local master (an old copy of a commit
    # pushed rebased) was checked out first, then the detach failed, and the tree was left on that older state.
    if "${g[@]}" merge-base --is-ancestor "refs/heads/$branch" "$sha" 2>/dev/null && "${g[@]}" checkout -q "$branch" 2>/dev/null; then
      "${g[@]}" merge -q --ff-only "$sha" || die "$label: cannot fast-forward to ${sha:0:7} (local changes in the way?$held)"
    else
      "${g[@]}" checkout -q --detach "$sha" || die "$label: cannot check out ${sha:0:7} (local changes in the way?$held)"
    fi
    if (( stashed )); then
      if "${g[@]}" stash apply -q >/dev/null 2>&1 && json_ok "${paths[@]}"; then
        "${g[@]}" stash drop -q && echo "note  $label: local edits to ${clash[*]} kept on top of ${sha:0:7}"
      else
        "${g[@]}" checkout -q HEAD -- "${specs[@]}"
        echo "note  $label: local edits to ${clash[*]} do not fit on top of ${sha:0:7}: the snapshot's version is in place, the edits are in \`git --git-dir=$DOTDIR stash list\` (newest)"
      fi
    fi
    echo "ok    $label at ${sha:0:7}"
  elif "${g[@]}" merge-base --is-ancestor "$sha" "$cur"; then
    if (( fwd_only )); then echo "ok    $label: already past the snapshot (at ${cur:0:7}), left as is"; return; fi
    "${g[@]}" checkout -q --detach "$sha" || die "$label: cannot check out ${sha:0:7} (local changes in the way?)"
    echo "note  $label: rolled back to ${sha:0:7}, detached (was ${cur:0:7})"
  else
    die "$label: ${cur:0:7} has local commits that are not in the snapshot -- push or drop them first"
  fi
}

# repos: work that has not reached origin, on this machine (station-maintenance beast-arch 76). Every system repo and
# every ~/projects/* checkout, one line each: branch, ahead/behind its upstream AS OF ITS LAST FETCH (nothing is
# fetched here: read-only, and fast), tracked files changed, and how old that fetch is. Made after a session on
# beast-arch sat on an unpushed commit, 41 behind, that collided with pushed work and cited a SHA nobody else had.
repo_report() {
  local d a b dirty fetched now; local -a g
  now=$(date +%s)
  for d in "$DOTDIR" "$SECRETS" "$HOME"/projects/*/; do
    d=${d%/}
    if [[ $d == "$DOTDIR" ]]; then [[ -d $d ]] || continue; g=(git --git-dir="$d" --work-tree="$HOME")
    else [[ -e $d/.git ]] || continue; g=(git -C "$d"); fi
    fetched=$(stat -c %Y "$("${g[@]}" rev-parse --absolute-git-dir)/FETCH_HEAD" 2>/dev/null || echo 0)
    fetched=$(( fetched ? (now - fetched) / 3600 : -1 ))
    dirty=$("${g[@]}" status --porcelain -uno 2>/dev/null | wc -l)
    if ! "${g[@]}" symbolic-ref -q HEAD >/dev/null; then
      echo "repo ${d/#$HOME/\~} detached ahead=- behind=- dirty=$dirty fetched=${fetched}h"; continue; fi
    if ! read -r a b < <("${g[@]}" rev-list --left-right --count 'HEAD...@{u}' 2>/dev/null); then
      echo "repo ${d/#$HOME/\~} $("${g[@]}" branch --show-current) no-upstream dirty=$dirty fetched=${fetched}h"; continue; fi
    echo "repo ${d/#$HOME/\~} $("${g[@]}" branch --show-current) ahead=$a behind=$b dirty=$dirty fetched=${fetched}h"
  done
}

read -r -a req <<<"${SSH_ORIGINAL_COMMAND:-$*}"
case ${req[0]:-} in
  status)       # held packages first ("hold <pkg> <installed> <source>"), the applied line LAST
                for p in $(awk -F': *' '$1 == "ignore-pkgs" { sub(/^[^:]*: */, ""); sub(/ *--.*$/, ""); gsub(/,/, " "); print; exit }' "$HOLD" 2>/dev/null); do
                  echo "hold $p $(pacman -Q "$p" 2>/dev/null | cut -d' ' -f2) local"; done
                for p in $(awk -v h="$HOST" '$1 == h { print $2 }' "$REPO/holds" 2>/dev/null); do
                  echo "hold $p $(pacman -Q "$p" 2>/dev/null | cut -d' ' -f2) repo"; done
                cat "$STATE/applied" 2>/dev/null || echo "none"; exit 0 ;;
  secrets-push) secrets_push; exit 0 ;;
  repos)        repo_report; exit 0 ;;
  apply)        ;;
  *)            die "request must be: status | repos | secrets-push | apply <ab> <dot> <sec> [stage ...|keys]" ;;
esac
ab=${req[1]:-} dot=${req[2]:-} sec=${req[3]:-}
for s in "$ab" "$dot" "$sec"; do
  [[ $s =~ ^[0-9a-f]{40}$ ]] || die "apply needs three full commit ids (arch-bootstrap dotfiles secrets): '$s'"
done
stages=("${req[@]:4}")
keys_only=0
if [[ ${stages[*]:-} == keys ]]; then keys_only=1; stages=()
else
  (( ${#stages[@]} )) || read -r -a stages <<<"$DEFAULT"
  for s in "${stages[@]}"; do [[ " $ALLOWED " == *" $s "* ]] || die "stage not allowed here: $s (allowed: $ALLOWED, or keys)"; done
fi
if [[ -f $HOLD ]] && (( ${#stages[@]} )); then
  keep=()
  for s in "${stages[@]}"; do
    reason=$(awk -v s="$s" -F': *' '$1 == s { sub(/^[^:]*: */, ""); print; exit }' "$HOLD")
    if [[ -n $reason ]]; then echo "hold  $s: $reason"; else keep+=("$s"); fi
  done
  stages=(${keep[@]+"${keep[@]}"})
fi
ignore=""
if [[ -f $HOLD ]]; then
  ignore=$(awk -F': *' '$1 == "ignore-pkgs" { sub(/^[^:]*: */, ""); sub(/ *--.*$/, ""); print; exit }' "$HOLD")
  [[ -z $ignore || $ignore =~ ^[a-z0-9@._+-]+(,[a-z0-9@._+-]+)*$ ]] || die "bad ignore-pkgs in $HOLD: $ignore"
  [[ -n $ignore ]] && echo "hold  packages not upgraded: $ignore"
fi
IFS= read -r pw || die "no sudo password on stdin"

# 1. The snapshot: exactly these three commits.
self_sum=$(sha256sum < "$REPO/tools/fleet-apply")
move arch-bootstrap "${FLEET_AB_BRANCH:-main}" "$ab" 0 git -C "$REPO"
# This script is part of what just moved: run the new copy for the rest, once, so a fix to fleet-apply works in the
# fpush that delivers it, not one run later (surfboard, then carbon and media-center, failed twice that way on
# 2026-10-24). The new copy repeats the cheap steps above; the password reaches it on a pipe.
if [[ -z ${FLEET_APPLY_REEXEC:-} && $(sha256sum < "$REPO/tools/fleet-apply") != "$self_sum" ]]; then
  echo "note  fleet-apply changed with this snapshot: continuing with the new copy"
  FLEET_APPLY_REEXEC=1 exec "$REPO/tools/fleet-apply" "${req[@]}" < <(printf '%s\n' "$pw")
fi
if [[ -d $DOTDIR ]]; then
  move dotfiles "${FLEET_DOT_BRANCH:-master}" "$dot" 0 git --git-dir="$DOTDIR" --work-tree="$HOME"
fi
move secrets "${FLEET_SEC_BRANCH:-master}" "$sec" 1 git -C "$SECRETS"
# git writes a changed file with the umask (644), so the vault turned world-readable on beast-arch when 19a3c2e was
# fast-forwarded there (2026-10-17 09:59; station-maintenance beast-arch 104). KeePassXC keeps 600 when it saves.
[[ -f $SECRETS/$VAULT ]] && chmod 600 "$SECRETS/$VAULT"

# 2. Who may log in: only from the reviewed secrets commit (the weekly sync timer is gone).
if [[ -x $REPO/tools/authorized-keys && -f $SECRETS/ssh/authorized_keys/$HOST ]]; then
  SECRETS_DIR=$SECRETS AK_HOST=$HOST "$REPO/tools/authorized-keys" enable --yes || die "authorized_keys not installed"
fi

# 3. Stages, in one pty so sudo's ticket covers the whole run.
mkdir -p "$STATE"
rc=0
if (( ${#stages[@]} )); then
  only=$(IFS=,; echo "${stages[*]}")
  exec 3<<<"$pw"
  unset pw
  script -qfec "sudo -S -p '' -v <&3 && exec 3<&- && cd '$REPO' && PACMAN_IGNORE='$ignore' ./bootstrap.sh --only $only" \
    "$STATE/last.log" </dev/null || rc=$?
  exec 3<&-
else
  unset pw
  if (( keys_only )); then echo "info  keys only: no stages run"; else echo "info  no stages left to run"; fi
fi
printf '%s %s %s %s rc=%s stages=%s\n' "$ab" "$dot" "$sec" "$(date -Iseconds)" "$rc" \
  "$( ((keys_only)) && echo keys || echo "${stages[*]:-none}")" > "$STATE/applied"
echo "done  rc=$rc (log: $STATE/last.log)"
exit "$rc"
