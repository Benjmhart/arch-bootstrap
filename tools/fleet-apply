#!/usr/bin/env bash
# fleet-apply -- the per-machine half of a fleet update driven from micro (tools/fleet;
# station-maintenance beast-arch task 80). It is the forced command of micro's fleet key in
# each machine's authorized_keys, so that key can run this and nothing else. On micro itself
# tools/fleet runs it directly.
#
# Request (SSH_ORIGINAL_COMMAND over ssh, else the arguments):
#   status                          print the last applied line ("<sha> <time> rc=<n> stages=...")
#   apply <main|SHA> [stage ...]    update arch-bootstrap to latest main, or to SHA (which must be
#                                   on origin/main -- the "last known safe commit" after a security
#                                   event), fast-forward the dotfiles, then run the stages.
#   secrets                         bring ~/secrets in line with origin (fleet push runs this on
#                                   every machine first, beast-arch first). Rules (Ben, 2026-10-08):
#                                   beast-arch is the source of truth, above all for the KeePassXC
#                                   vault, whose merges are destructive -- so nothing is ever merged:
#                                     in sync               ok
#                                     vault saved, not committed, on beast-arch
#                                                           committed ("Passwords.kdbx: saved <time>
#                                                           on beast-arch"), then as below. KeePassXC
#                                                           saves by rename, so the file is whole
#                                     ahead only            pushed; a vault commit anywhere but
#                                                           beast-arch is an error instead
#                                     behind only           fast-forwarded; an error if the incoming
#                                                           commits touch the vault while KeePassXC
#                                                           runs here (it would overwrite them)
#                                     diverged              rebased onto origin and pushed, but only
#                                                           when the incoming commits leave the vault
#                                                           alone; a conflict aborts. Otherwise an error
#                                     any other uncommitted change   an error: a human sorts it out
#                                   Exit 0 in line, 1 out of sync (fleet push then skips this machine).
#
# For apply, the FIRST LINE OF STDIN is the shared sudo password. It is handed to `sudo -S -v`
# on fd 3 inside a private pty (script), so sudo caches it for that pty and every sudo the
# bootstrap runs there uses the ticket. It never goes to disk, argv or the environment. Prompts
# inside the run read EOF and take their default (no): nothing unattended answers "yes".
#
# Stages are limited to ALLOWED. ~/.config/fleet/hold, per machine:
#   <stage>: <reason>                     skip that stage, and say why
#   ignore-pkgs: <pkg>[,<pkg>] -- <reason>  keep those packages from upgrading (PACMAN_IGNORE)
# e.g. beast-arch keeps `linux` while a task-1 RAM window is open, but still installs new packages.
set -euo pipefail
umask 077
REPO=${FLEET_REPO:-$HOME/projects/arch-bootstrap}
STATE=${FLEET_STATE:-$HOME/.local/state/fleet}
HOLD=${FLEET_HOLD:-$HOME/.config/fleet/hold}
DOTDIR=${FLEET_DOTDIR:-$HOME/.dot}
SECRETS=${FLEET_SECRETS:-$HOME/secrets}
VAULT=Passwords.kdbx
VAULT_HOST=${FLEET_VAULT_HOST:-beast-arch}
HOST=${FLEET_HOST:-$(uname -n)}
ALLOWED="packages aur toolchains services xmonad verify"
DEFAULT="packages aur services xmonad verify"
die() { echo "FAIL  $*"; exit 1; }

read -r -a req <<<"${SSH_ORIGINAL_COMMAND:-$*}"
sync_secrets() {
  local g=(git -C "$SECRETS") ahead behind dirty incoming outgoing
  touches() { [[ $'\n'$1$'\n' == *$'\n'"$VAULT"$'\n'* ]]; }   # a file list names the vault
  [[ -d $SECRETS/.git ]] || die "secrets: no checkout at $SECRETS"
  "${g[@]}" fetch -q origin || die "secrets: fetch failed"
  dirty=$("${g[@]}" status --porcelain | awk '{print $2}')
  if [[ -n $dirty && $HOST == "$VAULT_HOST" && $dirty == "$VAULT" ]]; then
    "${g[@]}" commit -q -m "$VAULT: saved $(date -r "$SECRETS/$VAULT" '+%F %H:%M') on $HOST" -- "$VAULT" \
      || die "secrets: could not commit the saved vault on $HOST"
    echo "did   secrets: committed the saved $VAULT on $HOST"
  elif [[ -n $dirty ]]; then
    die "secrets: uncommitted changes on $HOST: $(tr '\n' ' ' <<<"$dirty")-- commit them (the vault only on $VAULT_HOST) or discard"
  fi
  ahead=$("${g[@]}" rev-list --count '@{u}..HEAD'); behind=$("${g[@]}" rev-list --count 'HEAD..@{u}')
  incoming=$("${g[@]}" diff --name-only 'HEAD...@{u}'); outgoing=$("${g[@]}" diff --name-only '@{u}...HEAD')
  if (( ahead )) && [[ $HOST != "$VAULT_HOST" ]] && touches "$outgoing"; then
    die "secrets: $HOST has unpushed $VAULT commits -- the vault's source of truth is $VAULT_HOST; redo the change there"
  fi
  if (( ahead && behind )); then
    touches "$incoming" && die "secrets: diverged on $HOST ($ahead ahead, $behind behind) and origin changed $VAULT -- the vault is never merged; sort it out by hand"
    "${g[@]}" rebase -q '@{u}' >/dev/null 2>&1 || { "${g[@]}" rebase --abort 2>/dev/null
      die "secrets: diverged on $HOST ($ahead ahead, $behind behind) and the rebase conflicts -- nothing changed; sort it out by hand"; }
    echo "did   secrets: rebased $ahead local commit(s) onto $behind from origin on $HOST"
    behind=0
  fi
  if (( ahead )); then
    "${g[@]}" push -q origin HEAD || die "secrets: push failed on $HOST"
    echo "did   secrets: pushed $ahead commit(s) from $HOST"
  elif (( behind )); then
    if touches "$incoming" && pgrep -x keepassxc >/dev/null; then
      die "secrets: $HOST is $behind behind with $VAULT changes, and KeePassXC is running -- close it, then re-run"
    fi
    "${g[@]}" merge -q --ff-only '@{u}' || die "secrets: fast-forward failed on $HOST"
    echo "did   secrets: fast-forwarded $behind commit(s) on $HOST"
  else
    echo "ok    secrets in sync on $HOST"
  fi
}

case ${req[0]:-} in
  status)  cat "$STATE/applied" 2>/dev/null || echo "none"; exit 0 ;;
  secrets) sync_secrets; exit 0 ;;
  apply)   ;;
  *)       die "request must be: status | secrets | apply <main|SHA> [stage ...]" ;;
esac
target=${req[1]:-}
[[ $target == main || $target =~ ^[0-9a-f]{7,40}$ ]] || die "target must be main or a commit SHA: '$target'"
stages=("${req[@]:2}")
(( ${#stages[@]} )) || read -r -a stages <<<"$DEFAULT"
for s in "${stages[@]}"; do [[ " $ALLOWED " == *" $s "* ]] || die "stage not allowed here: $s (allowed: $ALLOWED)"; done
if [[ -f $HOLD ]]; then
  keep=()
  for s in "${stages[@]}"; do
    reason=$(awk -v s="$s" -F': *' '$1 == s { sub(/^[^:]*: */, ""); print; exit }' "$HOLD")
    if [[ -n $reason ]]; then echo "hold  $s: $reason"; else keep+=("$s"); fi
  done
  stages=(${keep[@]+"${keep[@]}"})
fi
ignore=""
if [[ -f $HOLD ]]; then
  ignore=$(awk -F': *' '$1 == "ignore-pkgs" { sub(/^[^:]*: */, ""); sub(/ *--.*$/, ""); print; exit }' "$HOLD")
  [[ -z $ignore || $ignore =~ ^[a-z0-9@._+-]+(,[a-z0-9@._+-]+)*$ ]] || die "bad ignore-pkgs in $HOLD: $ignore"
  [[ -n $ignore ]] && echo "hold  packages not upgraded: $ignore"
fi
IFS= read -r pw || die "no sudo password on stdin"

# 1. Code: latest main, or a pinned commit that main contains.
git -C "$REPO" fetch -q origin || die "arch-bootstrap fetch failed"
if [[ $target == main ]]; then
  git -C "$REPO" checkout -q main && git -C "$REPO" merge -q --ff-only origin/main \
    || die "arch-bootstrap main cannot fast-forward (local commits?)"
else
  git -C "$REPO" rev-parse -q --verify "$target^{commit}" >/dev/null || die "unknown commit: $target"
  git -C "$REPO" merge-base --is-ancestor "$target" origin/main || die "$target is not on origin/main"
  git -C "$REPO" checkout -q --detach "$target"
fi
sha=$(git -C "$REPO" rev-parse HEAD)
echo "ok    arch-bootstrap at ${sha:0:7}"

# 2. Dotfiles: fast-forward when nothing local is in the way (a dirty file the update does not
# touch is fine; git refuses otherwise, and that is reported, not forced).
if [[ -d $DOTDIR ]]; then
  dot=(git --git-dir="$DOTDIR" --work-tree="$HOME")
  if "${dot[@]}" fetch -q origin && "${dot[@]}" merge -q --ff-only origin/master 2>/dev/null; then
    echo "ok    dotfiles at $("${dot[@]}" rev-parse --short HEAD)"
  else
    echo "warn  dotfiles not fast-forwarded (local commits, or local changes in the way)"
  fi
fi

# 3. Stages, in one pty so sudo's ticket covers the whole run.
mkdir -p "$STATE"
rc=0
if (( ${#stages[@]} )); then
  only=$(IFS=,; echo "${stages[*]}")
  exec 3<<<"$pw"
  unset pw
  script -qfec "sudo -S -p '' -v <&3 && exec 3<&- && cd '$REPO' && PACMAN_IGNORE='$ignore' ./bootstrap.sh --only $only" \
    "$STATE/last.log" </dev/null || rc=$?
  exec 3<&-
else
  unset pw
  echo "info  no stages left to run"
fi
printf '%s %s rc=%s stages=%s\n' "$sha" "$(date -Iseconds)" "$rc" "${stages[*]:-none}" > "$STATE/applied"
echo "done  rc=$rc (log: $STATE/last.log)"
exit "$rc"
