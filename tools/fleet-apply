#!/usr/bin/env bash
# fleet-apply -- the per-machine half of a fleet update driven from micro (tools/fleet;
# station-maintenance beast-arch task 80). It is the forced command of micro's fleet key in
# each machine's authorized_keys, so that key can run this and nothing else. On micro itself
# tools/fleet runs it directly.
#
# Trust model (Ben, 2026-10-08): beast-arch, carbon and media-center are "dirty" -- a compromise
# may happen there, and each can push to GitHub. micro is the trusted place. So a machine never
# applies "whatever is on GitHub": it applies a SNAPSHOT -- one commit per repo -- that Ben
# reviewed on micro. A git commit id names its whole tree and history, so a commit pushed after
# the review, or one Ben excluded, cannot ride along.
#
# Requests (SSH_ORIGINAL_COMMAND over ssh, else the arguments):
#   status                         the last applied line: "<ab> <dot> <sec> <time> rc=<n> stages=..."
#   secrets-push                   phase 1 of a push: hand this machine's own secrets commits to
#                                  origin, so the review sees them. Never pulls. beast-arch is the
#                                  source of truth for the KeePassXC vault, whose merges are
#                                  destructive, so nothing is ever merged:
#                                    vault saved, not committed, on beast-arch -> committed, pushed
#                                    ahead -> pushed; a vault commit off beast-arch is an error
#                                    diverged -> rebased + pushed only if origin left the vault
#                                      alone and nothing conflicts (a conflict aborts); else error
#                                    any other uncommitted change -> error
#                                  Exit 1 = out of sync: the push skips this machine.
#   apply <ab> <dot> <sec> [stage ...|keys]
#                                  move arch-bootstrap, the dotfiles and secrets to exactly those
#                                  commits (each must be on its origin branch), install
#                                  authorized_keys from that secrets commit, then run the stages
#                                  ("keys": only the moves and the keys -- an urgent revocation).
#                                  Forward moves fast-forward the branch; an OLDER commit (a
#                                  rollback) is checked out detached. Secrets only ever move forward:
#                                  rolling the vault back would lose passwords.
#
# For apply, the FIRST LINE OF STDIN is the shared sudo password. It is handed to `sudo -S -v`
# on fd 3 inside a private pty (script), so sudo caches it for that pty and every sudo the
# bootstrap runs there uses the ticket. It never goes to disk, argv or the environment. Prompts
# inside the run read EOF and take their default (no): nothing unattended answers "yes".
#
# Stages are limited to ALLOWED. ~/.config/fleet/hold, per machine:
#   <stage>: <reason>                       skip that stage, and say why
#   ignore-pkgs: <pkg>[,<pkg>] -- <reason>  keep those packages from upgrading (PACMAN_IGNORE)
set -euo pipefail
umask 077
REPO=${FLEET_REPO:-$HOME/projects/arch-bootstrap}
STATE=${FLEET_STATE:-$HOME/.local/state/fleet}
HOLD=${FLEET_HOLD:-$HOME/.config/fleet/hold}
DOTDIR=${FLEET_DOTDIR:-$HOME/.dot}
SECRETS=${FLEET_SECRETS:-$HOME/secrets}
VAULT=Passwords.kdbx
VAULT_HOST=${FLEET_VAULT_HOST:-beast-arch}
HOST=${FLEET_HOST:-$(uname -n)}
ALLOWED="packages aur toolchains services xmonad verify"
DEFAULT="packages aur services xmonad verify"
die() { echo "FAIL  $*"; exit 1; }
touches() { [[ $'\n'$1$'\n' == *$'\n'"$VAULT"$'\n'* ]]; }   # a file list names the vault

secrets_push() {
  local g=(git -C "$SECRETS") ahead behind dirty incoming outgoing
  [[ -d $SECRETS/.git ]] || die "secrets: no checkout at $SECRETS"
  "${g[@]}" fetch -q origin || die "secrets: fetch failed"
  dirty=$("${g[@]}" status --porcelain | awk '{print $2}')
  if [[ -n $dirty && $HOST == "$VAULT_HOST" && $dirty == "$VAULT" ]]; then
    "${g[@]}" commit -q -m "$VAULT: saved $(date -r "$SECRETS/$VAULT" '+%F %H:%M') on $HOST" -- "$VAULT" \
      || die "secrets: could not commit the saved vault on $HOST"
    echo "did   secrets: committed the saved $VAULT on $HOST"
  elif [[ -n $dirty ]]; then
    die "secrets: uncommitted changes on $HOST: $(tr '\n' ' ' <<<"$dirty")-- commit them (the vault only on $VAULT_HOST) or discard"
  fi
  ahead=$("${g[@]}" rev-list --count '@{u}..HEAD'); behind=$("${g[@]}" rev-list --count 'HEAD..@{u}')
  incoming=$("${g[@]}" diff --name-only 'HEAD...@{u}'); outgoing=$("${g[@]}" diff --name-only '@{u}...HEAD')
  if (( ahead )) && [[ $HOST != "$VAULT_HOST" ]] && touches "$outgoing"; then
    die "secrets: $HOST has unpushed $VAULT commits -- the vault's source of truth is $VAULT_HOST; redo the change there"
  fi
  if (( ahead && behind )); then
    touches "$incoming" && die "secrets: diverged on $HOST ($ahead ahead, $behind behind) and origin changed $VAULT -- the vault is never merged; sort it out by hand"
    "${g[@]}" rebase -q '@{u}' >/dev/null 2>&1 || { "${g[@]}" rebase --abort 2>/dev/null
      die "secrets: diverged on $HOST ($ahead ahead, $behind behind) and the rebase conflicts -- nothing changed; sort it out by hand"; }
    echo "did   secrets: rebased $ahead local commit(s) onto origin on $HOST"
  fi
  if (( ahead )); then
    "${g[@]}" push -q origin HEAD || die "secrets: push failed on $HOST"
    echo "did   secrets: pushed $ahead commit(s) from $HOST"
  else
    echo "ok    secrets: nothing to push from $HOST"
  fi
}

# move <label> <branch> <sha> <forward-only 0|1> <git cmd...>: put a checkout at exactly <sha>,
# which must be on origin/<branch>. Forward: fast-forward the branch (detached if the branch has
# other commits). Older (a rollback): detached, unless forward-only.
move() {
  local label=$1 branch=$2 sha=$3 fwd_only=$4; shift 4
  local g=("$@") cur
  "${g[@]}" fetch -q origin || die "$label: fetch failed"
  "${g[@]}" cat-file -e "$sha^{commit}" 2>/dev/null || die "$label: unknown commit $sha"
  "${g[@]}" merge-base --is-ancestor "$sha" "origin/$branch" || die "$label: ${sha:0:7} is not on origin/$branch"
  cur=$("${g[@]}" rev-parse HEAD)
  if "${g[@]}" merge-base --is-ancestor "$cur" "$sha"; then
    if [[ $label == secrets ]] && touches "$("${g[@]}" diff --name-only "$cur" "$sha")" && pgrep -x keepassxc >/dev/null; then
      die "secrets: the snapshot changes $VAULT and KeePassXC is running on $HOST -- close it, then re-run"
    fi
    if "${g[@]}" checkout -q "$branch" 2>/dev/null && "${g[@]}" merge-base --is-ancestor HEAD "$sha"; then
      "${g[@]}" merge -q --ff-only "$sha" || die "$label: cannot fast-forward to ${sha:0:7} (local changes in the way?)"
    else
      "${g[@]}" checkout -q --detach "$sha" || die "$label: cannot check out ${sha:0:7} (local changes in the way?)"
    fi
    echo "ok    $label at ${sha:0:7}"
  elif "${g[@]}" merge-base --is-ancestor "$sha" "$cur"; then
    if (( fwd_only )); then echo "ok    $label: already past the snapshot (at ${cur:0:7}), left as is"; return; fi
    "${g[@]}" checkout -q --detach "$sha" || die "$label: cannot check out ${sha:0:7} (local changes in the way?)"
    echo "note  $label: rolled back to ${sha:0:7}, detached (was ${cur:0:7})"
  else
    die "$label: ${cur:0:7} has local commits that are not in the snapshot -- push or drop them first"
  fi
}

read -r -a req <<<"${SSH_ORIGINAL_COMMAND:-$*}"
case ${req[0]:-} in
  status)       cat "$STATE/applied" 2>/dev/null || echo "none"; exit 0 ;;
  secrets-push) secrets_push; exit 0 ;;
  apply)        ;;
  *)            die "request must be: status | secrets-push | apply <ab> <dot> <sec> [stage ...|keys]" ;;
esac
ab=${req[1]:-} dot=${req[2]:-} sec=${req[3]:-}
for s in "$ab" "$dot" "$sec"; do
  [[ $s =~ ^[0-9a-f]{40}$ ]] || die "apply needs three full commit ids (arch-bootstrap dotfiles secrets): '$s'"
done
stages=("${req[@]:4}")
keys_only=0
if [[ ${stages[*]:-} == keys ]]; then keys_only=1; stages=()
else
  (( ${#stages[@]} )) || read -r -a stages <<<"$DEFAULT"
  for s in "${stages[@]}"; do [[ " $ALLOWED " == *" $s "* ]] || die "stage not allowed here: $s (allowed: $ALLOWED, or keys)"; done
fi
if [[ -f $HOLD ]] && (( ${#stages[@]} )); then
  keep=()
  for s in "${stages[@]}"; do
    reason=$(awk -v s="$s" -F': *' '$1 == s { sub(/^[^:]*: */, ""); print; exit }' "$HOLD")
    if [[ -n $reason ]]; then echo "hold  $s: $reason"; else keep+=("$s"); fi
  done
  stages=(${keep[@]+"${keep[@]}"})
fi
ignore=""
if [[ -f $HOLD ]]; then
  ignore=$(awk -F': *' '$1 == "ignore-pkgs" { sub(/^[^:]*: */, ""); sub(/ *--.*$/, ""); print; exit }' "$HOLD")
  [[ -z $ignore || $ignore =~ ^[a-z0-9@._+-]+(,[a-z0-9@._+-]+)*$ ]] || die "bad ignore-pkgs in $HOLD: $ignore"
  [[ -n $ignore ]] && echo "hold  packages not upgraded: $ignore"
fi
IFS= read -r pw || die "no sudo password on stdin"

# 1. The snapshot: exactly these three commits.
move arch-bootstrap "${FLEET_AB_BRANCH:-main}" "$ab" 0 git -C "$REPO"
if [[ -d $DOTDIR ]]; then
  move dotfiles "${FLEET_DOT_BRANCH:-master}" "$dot" 0 git --git-dir="$DOTDIR" --work-tree="$HOME"
fi
move secrets "${FLEET_SEC_BRANCH:-master}" "$sec" 1 git -C "$SECRETS"

# 2. Who may log in: only from the reviewed secrets commit (the weekly sync timer is gone).
if [[ -x $REPO/tools/authorized-keys && -f $SECRETS/ssh/authorized_keys/$HOST ]]; then
  SECRETS_DIR=$SECRETS AK_HOST=$HOST "$REPO/tools/authorized-keys" enable --yes || die "authorized_keys not installed"
fi

# 3. Stages, in one pty so sudo's ticket covers the whole run.
mkdir -p "$STATE"
rc=0
if (( ${#stages[@]} )); then
  only=$(IFS=,; echo "${stages[*]}")
  exec 3<<<"$pw"
  unset pw
  script -qfec "sudo -S -p '' -v <&3 && exec 3<&- && cd '$REPO' && PACMAN_IGNORE='$ignore' ./bootstrap.sh --only $only" \
    "$STATE/last.log" </dev/null || rc=$?
  exec 3<&-
else
  unset pw
  if (( keys_only )); then echo "info  keys only: no stages run"; else echo "info  no stages left to run"; fi
fi
printf '%s %s %s %s rc=%s stages=%s\n' "$ab" "$dot" "$sec" "$(date -Iseconds)" "$rc" \
  "$( ((keys_only)) && echo keys || echo "${stages[*]:-none}")" > "$STATE/applied"
echo "done  rc=$rc (log: $STATE/last.log)"
exit "$rc"
