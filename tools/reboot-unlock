#!/usr/bin/env bash
# reboot-unlock <host> -- reboot <host>, then unlock its disk from here when it comes back: one command (Ben
# 2026-11-09). Run on micro (or carbon/beast-arch, which may also unlock). The reboot is `sudo reboot-to-unlock` (no
# password, written by bootstrap setup_boot): it skips the 5-minute GRUB menu once, into the password / remote entry.
# A host without it yet gets `sudo systemctl reboot` (a touch for sudo) and its menu's 5 minutes. Then one touch at the
# passphrase prompt (tools/unlock), which waits up to $UNLOCK_WAIT seconds (default 900) for <host>-boot.
set -uo pipefail
h=${1:?usage: reboot-unlock <host>}
here=$(dirname "$(readlink -f "$0")")
[[ $h != "$(uname -n)" ]] || { echo "reboot-unlock: not this machine ($h); nobody would be left to unlock it" >&2; exit 2; }
echo "rebooting $h for a remote unlock"
cmd=${REBOOT_CMD:-'if sudo -n -l /usr/local/bin/reboot-to-unlock >/dev/null 2>&1; then exec sudo -n /usr/local/bin/reboot-to-unlock; else echo "(no reboot-to-unlock here yet: sudo asks; the GRUB menu will wait its 5 minutes)"; exec sudo systemctl reboot; fi'}
ssh -t "$h" "$cmd"; rc=$?
# 255 = the connection dropped as the machine went down (the normal case); 0 = the reboot was accepted. Anything else is
# sudo (or the command) refusing: nothing was rebooted, so do not sit waiting for a boot that will not come.
if (( rc != 0 && rc != 255 )); then echo "reboot-unlock: the reboot was refused on $h (exit $rc): nothing rebooted" >&2; exit 1; fi
UNLOCK_WAIT=${UNLOCK_WAIT:-900} exec "$here/unlock" "$h"
