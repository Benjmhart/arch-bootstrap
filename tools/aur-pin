#!/usr/bin/env python3
"""aur-pin: AUR packages pinned to a commit of their AUR git repo (station-maintenance beast-arch 76).

pkglist-aur.txt lines:  <pkgname> <aur-commit> [<pkgbase>]     (pkgbase only when it differs, e.g. espanso)
Order matters: a package whose dependency is itself an AUR package comes after it (e.g. a lib before the app that needs it).

  aur-pin status              pinned version vs the AUR's current one, per package
  aur-pin bump NAME...        show what changed in the AUR repo since the pin (PKGBUILD, .install, patches),
                              ask, and move the pin in pkglist-aur.txt (commit and push it yourself; fpush reviews it)
  aur-pin find NAME VERSION   the AUR commit whose .SRCINFO says VERSION ([epoch:]pkgver-pkgrel)
  aur-pin plan                "name commit base version" for every pin whose version is not the one installed
                              (bootstrap.sh stage 20 builds exactly these)
  aur-pin changes OLD NEW     the pins that differ between two copies of pkglist-aur.txt, as "name: old -> new"
                              (fpush's review calls it for every commit that touches the list)
  aur-pin auto                move every pin to the AUR's newest commit this cache first saw AUR_PIN_COOLDOWN_DAYS
                              (3) or more days ago, unless its line says "# hold: why" (fpush runs it when the archive
                              date moves and commits both together, Ben 2026-10-21; otherwise only to count; before the
                              review; Ben 2026-10-17: "always be on the latest", no hand approvals). The checks
                              sort the change three ways, and none of them asks Ben:
                                avoid  looks like a compromise (adds npm/curl/..., a new download host, a SKIP
                                       checksum, rewritten history): the pin stays until the AUR drops it
                                late   a new committer, new maintainer lines, a changed .install or patch: moves
                                       once first seen AUR_PIN_SOFT_DAYS (14) ago, time for a hijack to be caught
                                move   anything else, and a "late" change that runs nothing (only comments,
                                       whitespace or licence files differ)

Repos are cached bare under ~/.cache/aur-pin. AUR_URL overrides https://aur.archlinux.org (tests)."""
import os, re, subprocess, sys, time

AUR = os.environ.get("AUR_URL", "https://aur.archlinux.org")
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "aur-pin")
COOLDOWN = float(os.environ.get("AUR_PIN_COOLDOWN_DAYS", "3")) * 86400
SOFT = float(os.environ.get("AUR_PIN_SOFT_DAYS", "14")) * 86400
# Tokens an AUR update may not ADD to a file that did not already use them: they fetch or run code no checksum
# pins, or reach for root, keys or persistence. The June 2026 "Atomic Arch" hijacks (orphans adopted by a new
# account, `npm install atomic-lockfile` / `bun install js-digest` added to PKGBUILD or .install) had this shape.
RISKY = re.compile(r"\b(?:npm|npx|pnpm|yarn|bunx?|pipx?|pip3|uvx?|gem|cargo install|go install|go run|curl|wget|nc|ncat"
                   r"|socat|base64|eval|sudo|systemctl|crontab|setcap|LD_PRELOAD|authorized_keys)\b"
                   r"|/dev/tcp|\\x[0-9a-fA-F]{2}|python3? -c|perl -e|chmod [ugo]*\+s|\.ssh/")
QUIET = {"PKGBUILD", ".SRCINFO", ".gitignore", ".nvchecker.toml"}    # any other changed file is flagged (.install runs as root)
LIST = os.environ.get("AUR_PIN_LIST", os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "pkglist-aur.txt"))

def git(repo, *args, check=True):
    r = subprocess.run(["git", "--git-dir", repo, *args], capture_output=True, text=True, errors="replace")
    if check and r.returncode:
        sys.exit(f"aur-pin: git {' '.join(args)} in {repo}: {r.stderr.strip()}")
    return r.stdout

def repo(base, fetch=True):
    path = os.path.join(CACHE, base + ".git")
    if not os.path.isdir(path):
        os.makedirs(CACHE, exist_ok=True)
        r = subprocess.run(["git", "clone", "-q", "--bare", f"{AUR}/{base}.git", path], capture_output=True, text=True)
        if r.returncode:
            sys.exit(f"aur-pin: cannot clone {AUR}/{base}.git: {r.stderr.strip()}")
        seen(path)
    elif fetch:
        git(path, "fetch", "-q", "origin", "+refs/heads/*:refs/heads/*")
        seen(path)
    return path

def seen(path):
    """commit -> when this cache first saw it. The cooldown counts from here, not from the commit's own date, which
    its author sets. The first record of a repo trusts the commit dates once."""
    f = os.path.join(path, "aur-pin-seen")
    known = dict(l.split() for l in open(f)) if os.path.exists(f) else {}
    first, new = not known, []
    for line in git(path, "log", "--all", "--format=%H %ct").splitlines():
        c, ct = line.split()
        if c not in known:
            known[c] = ct if first else str(int(time.time()))
            new.append(f"{c} {known[c]}\n")
    if new:
        open(f, "a").writelines(new)
    return {c: int(t) for c, t in known.items()}

def inert(text):
    """A file as the build sees it: comment lines and all whitespace gone."""
    return "".join("".join(l.split()) for l in text.splitlines() if not l.lstrip().startswith("#"))

def checks(p, pin, new):
    """(hard, soft): reasons to avoid the move pin -> new, and reasons to let it age SOFT first."""
    if subprocess.run(["git", "--git-dir", p, "merge-base", "--is-ancestor", pin, new]).returncode:
        return ["the AUR history was rewritten (the pin is not an ancestor)"], []
    hard, soft, runs = [], [], False
    old = set(git(p, "log", "--format=%an <%ae>", pin).splitlines())
    soft += [f"new committer {a}" for a in sorted(set(git(p, "log", "--format=%an <%ae>", f"{pin}..{new}").splitlines()) - old)]
    for f in git(p, "diff", "--name-only", pin, new).splitlines():
        if re.fullmatch(r"LICENSE.*|LICENSES/.*|REUSE\.toml|\.gitignore|\.nvchecker\.toml", f):    # run nothing
            continue
        a, b = git(p, "show", f"{pin}:{f}", check=False), git(p, "show", f"{new}:{f}", check=False)
        runs |= inert(a) != inert(b)
        if f not in QUIET:
            soft.append(f"changes {f}")
        if f == ".SRCINFO":
            continue
        had = {m.group(0) for m in RISKY.finditer(a)}
        added = [l[1:] for l in git(p, "diff", "-U0", pin, new, "--", f).splitlines() if l.startswith("+") and not l.startswith("+++")]
        hard += [f"{f} adds '{t}'" for t in sorted({m.group(0) for l in added for m in RISKY.finditer(l)} - had)]
        if f == "PKGBUILD" and any(re.match(r"#\s*(Maintainer|Contributor)", l) for l in added):
            soft.append("PKGBUILD changes its Maintainer/Contributor lines")
    def srcinfo(c):
        s = git(p, "show", f"{c}:.SRCINFO")
        return ({m.group(1) for m in re.finditer(r"^\s*source\w*\s*=\s*(?:[^:\s]*::)?(?:\w+\+)?\w+://([^/\s]+)", s, re.M)},
                len(re.findall(r"^\s*\w+sums\w*\s*=\s*SKIP\s*$", s, re.M)))
    (h0, s0), (h1, s1) = srcinfo(pin), srcinfo(new)
    hard += [f"downloads from a new host {h}" for h in sorted(h1 - h0)]
    if s1 > s0:
        hard.append("more sources without a checksum (SKIP)")
    return hard, soft if runs else []

def version(path, commit):
    """[epoch:]pkgver-pkgrel from .SRCINFO at commit (the pkgbase section)."""
    info = {}
    for line in git(path, "show", f"{commit}:.SRCINFO").splitlines():
        if line.startswith("pkgname"):
            break
        m = re.match(r"\s*(pkgver|pkgrel|epoch)\s*=\s*(\S+)", line)
        if m:
            info[m.group(1)] = m.group(2)
    v = f"{info['pkgver']}-{info['pkgrel']}"
    return f"{info['epoch']}:{v}" if info.get("epoch", "0") != "0" else v

def entries(path=None):
    out = []
    for n, line in enumerate(open(path or LIST), 1):
        f = line.split("#", 1)[0].split()
        if not f:
            continue
        if len(f) < 2 or not re.fullmatch(r"[0-9a-f]{40}", f[1]):
            sys.exit(f"aur-pin: {path or LIST}:{n}: '{line.strip()}' -- want '<pkgname> <40-hex aur commit> [<pkgbase>]'")
        out.append((f[0], f[1], f[2] if len(f) > 2 else f[0], n))
    return out

def installed(name):
    r = subprocess.run(["pacman", "-Q", name], capture_output=True, text=True)
    return r.stdout.split()[1] if r.returncode == 0 else None

def head(path):
    return git(path, "rev-parse", "HEAD").strip()

def cmd_status(_):
    for name, pin, base, _n in entries():
        p = repo(base); h = head(p)
        pv, hv = version(p, pin), version(p, h)
        mark = "" if pin == h else f"   AUR now {hv} ({h[:8]})"
        print(f"{name:36} pinned {pv:24} installed {installed(name) or '-':24}{mark}")

def cmd_find(args):
    name, want = args
    base = next((b for n, _c, b, _l in entries() if n == name), name)
    p = repo(base)
    for c in git(p, "log", "--format=%H", "HEAD", "--", ".SRCINFO").split():
        if version(p, c) == want:
            print(c); return
    sys.exit(f"aur-pin: no commit of {base} has version {want}")

def cmd_plan(_):
    for name, pin, base, _n in entries():
        p = repo(base, fetch=False)
        if subprocess.run(["git", "--git-dir", p, "cat-file", "-e", f"{pin}^{{commit}}"]).returncode:
            p = repo(base)            # the pin is newer than the cache: fetch
        v = version(p, pin)
        if installed(name) != v:
            print(name, pin, base, v)

def cmd_bump(names):
    lines = open(LIST).read().splitlines(keepends=True)
    byname = {n: (c, b, l) for n, c, b, l in entries()}
    for name in names:
        if name not in byname:
            sys.exit(f"aur-pin: {name} is not in {LIST}")
        pin, base, lineno = byname[name]
        p = repo(base); h = head(p)
        if h == pin:
            print(f"{name}: already at the AUR's head ({version(p, h)})"); continue
        print(f"\n===== {name}: {version(p, pin)} -> {version(p, h)}   ({pin[:8]}..{h[:8]})")
        print(git(p, "log", "--format=  %h %ad %an  %s", "--date=short", f"{pin}..{h}"))
        print(git(p, "diff", "--stat", pin, h))
        print(git(p, "diff", pin, h, "--", ".", ":(exclude).SRCINFO", ":(exclude)*.zst", ":(exclude)*.tar.*"))
        hard, soft = checks(p, pin, h)
        print("".join(f"  avoid: {w}\n" for w in hard) + "".join(f"  late:  {w}\n" for w in soft) or "checks: nothing flagged")
        try:
            ans = input(f"move {name}'s pin to {h[:8]}? [y/N] ")
        except EOFError:
            ans = ""
        if ans.strip().lower() == "y":
            lines[lineno - 1] = re.sub(r"\b[0-9a-f]{40}\b", h, lines[lineno - 1], count=1)
            open(LIST, "w").write("".join(lines))
            print(f"pinned {name} at {h[:8]} -- commit and push pkglist-aur.txt; fpush shows it in the review")

def loose(path):
    """name -> (commit or None, base): also reads the pre-2026-10-17 list of bare names."""
    out = {}
    for line in open(path):
        f = line.split("#", 1)[0].split()
        if f:
            pin = f[1] if len(f) > 1 and re.fullmatch(r"[0-9a-f]{40}", f[1]) else None
            out[f[0]] = (pin, f[2] if len(f) > 2 else f[0])
    return out

def cmd_changes(args):
    old = loose(args[0])
    new = {n: (c, b) for n, c, b, _l in entries(args[1])}
    for name in sorted(set(old) | set(new)):
        o, n = old.get(name), new.get(name)
        if o == n:
            continue
        if not n:
            print(f"{name}: removed"); continue
        p = repo(n[1])
        nv = version(p, n[0])
        if not o:
            print(f"{name}: NEW at {nv} ({n[0][:8]})"); continue
        if not o[0]:
            print(f"{name}: unpinned -> {nv} ({n[0][:8]})"); continue
        ov = version(p, o[0])
        span = git(p, "rev-list", "--count", f"{o[0]}..{n[0]}", check=False).strip() or "?"
        print(f"{name}: {ov} -> {nv}  ({span} AUR commit(s); see them: tools/aur-pin bump {name} on a checkout at the OLD pin)")

def cmd_auto(_):
    lines = open(LIST).read().splitlines(keepends=True)
    hold = {m.group(1): m.group(2) or "held" for m in (re.match(r"\s*(\S+)\s[^#]*#\s*hold\b:?\s*(.*)", l) for l in lines) if m}
    cutoff, days = time.time() - COOLDOWN, COOLDOWN / 86400
    for name, pin, base, lineno in entries():
        if name in hold:
            print(f"hold   {name}: {hold[name].strip()}"); continue
        p = repo(base); when = seen(p); h = head(p)
        if h == pin:
            continue
        ripe = [c for c in git(p, "rev-list", f"{pin}..{h}").split() if when.get(c, time.time()) <= cutoff]
        if not ripe:
            print(f"wait   {name}: {version(p, h)} is newer than {days:g} days here"); continue
        span = f"{version(p, pin)} -> {version(p, ripe[0])}"
        hard, soft = checks(p, pin, ripe[0])
        if hard:
            print(f"avoid  {name} {span}: {'; '.join(hard + soft)}   (stays until the AUR drops it)"); continue
        if soft and when.get(ripe[0], time.time()) > time.time() - SOFT:
            due = time.strftime("%Y-%m-%d", time.localtime(when.get(ripe[0], time.time()) + SOFT))
            print(f"late   {name} {span}: {'; '.join(soft)}   (moves {due})"); continue
        lines[lineno - 1] = re.sub(r"\b[0-9a-f]{40}\b", ripe[0], lines[lineno - 1], count=1)
        print(f"move   {name} {span}")
    open(LIST, "w").write("".join(lines))

if __name__ == "__main__":
    cmds = {"auto": cmd_auto, "status": cmd_status, "find": cmd_find, "plan": cmd_plan, "bump": cmd_bump, "changes": cmd_changes}
    if len(sys.argv) < 2 or sys.argv[1] not in cmds:
        sys.exit(__doc__)
    cmds[sys.argv[1]](sys.argv[2:])
