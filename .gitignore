# Local configuration -- holds remotes and paths specific to you and your machines.
# This is the file that keeps everything else in this repo publishable.
bootstrap.conf

# Anything that looks like a key or a vault, in case one is ever dropped in here
# while debugging. Belt and braces for a public repo.
*.kdbx
*.pem
*.key
id_rsa*
id_ed25519*
!*.pub.example

# Scratch
*.log
*.bak
*.bak-*
.dotfiles-backup-*/
