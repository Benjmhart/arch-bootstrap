#!/bin/sh
# testvm-wait -- an Actions job's first step on surfboard (ACTIONS_RUNNER_HOOK_JOB_STARTED): wait while a test VM runs
# (tools/testvm). Ben 2026-11-20: "if either of the VM's are busy, surfboard should be unavailable for CI jobs".
# Timing tests failed under a busy VM (nihongo-smash PR #150, 2026-11-20). testvm stops an idle VM within 10-30 min.
# ponytail: any qemu counts as a test VM (surfboard runs no other); after 2 h the job runs anyway, rather than time out.
end=$(( $(date +%s) + 7200 ))
while pgrep -x qemu-system-x86_64 >/dev/null; do
  [ "$(date +%s)" -ge "$end" ] && { echo "testvm-wait: a test VM has run 2 h: running this job beside it"; exit 0; }
  [ -n "${said:-}" ] || { echo "testvm-wait: a test VM is running on $(uname -n); this job waits its turn"; said=1; }
  sleep 30
done
[ -n "${said:-}" ] && echo "testvm-wait: the VM is down: running"
exit 0
