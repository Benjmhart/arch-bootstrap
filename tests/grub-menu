#!/usr/bin/env bash
# tests/grub-menu -- the GRUB menu that bootstrap.sh's GRUB_10_ARCH writes must parse, or the machine does not boot
# (station-maintenance fleet 1/11). Runs the real 10_arch script with stand-in grub-probe, findmnt, cryptsetup, blkid
# and mountpoint, for a machine with a YubiKey enrolled and one without, and checks the result with GRUB's own
# grub-script-check. Caught on 2026-11-09 before it shipped: "this machine's YubiKey" put an apostrophe inside a
# single-quoted menuentry title, a syntax error in grub.cfg. Run: tests/grub-menu
set -uo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
command -v grub-script-check >/dev/null || { echo "skip  grub-script-check not installed"; exit 0; }
t=$(mktemp -d); trap 'rm -rf "$t"' EXIT
mkdir "$t/bin"
bash -c 'eval "$(sed -n "/^GRUB_10_ARCH=/,/^fi'"'"'\$/p" "$1")"; printf "%s\n" "$GRUB_10_ARCH"' _ "$root/bootstrap.sh" > "$t/10_arch"
cat > "$t/bin/grub-probe" <<'EOF'
#!/bin/sh
case "$*" in *fs_uuid*) echo ABCD-1234 ;; *--target=fs\ *) echo fat ;; *partmap*) echo gpt ;; esac
EOF
printf '#!/bin/sh\ncase "$*" in *UUID*) echo 11111111-2222 ;; *FSTYPE*) echo ext4 ;; *FSROOT*) echo / ;; esac\n' > "$t/bin/findmnt"
printf '#!/bin/sh\ncase "$1" in status) echo "  device:  /dev/sda2" ;; luksDump) [ -n "$KEYS" ] && echo "\\"type\\": \\"systemd-fido2\\"" || echo "{}" ;; esac\n' > "$t/bin/cryptsetup"
printf '#!/bin/sh\necho 33333333-4444\n' > "$t/bin/blkid"
printf '#!/bin/sh\nexit 0\n' > "$t/bin/mountpoint"
chmod +x "$t"/bin/*
pass=0 fail=0
check() { if eval "$2"; then pass=$((pass+1)); echo "pass  $1"; else fail=$((fail+1)); echo "FAIL  $1"; fi; }
for keys in 1 ""; do
  w=${keys:+with}; w=${w:-without}
  KEYS=$keys PATH=$t/bin:$PATH sh "$t/10_arch" > "$t/out.cfg"; rc=$?
  check "10_arch runs ($w a key)" '(( rc == 0 ))'
  { echo 'set timeout=300'; cat "$t/out.cfg"; } > "$t/full.cfg"
  check "grub.cfg parses ($w a key)" 'grub-script-check "$t/full.cfg" >/dev/null 2>&1'
  check "skip_menu clears itself ($w a key)" 'grep -q "save_env skip_menu" "$t/out.cfg"'
done
KEYS=1 PATH=$t/bin:$PATH sh "$t/10_arch" > "$t/out.cfg"
check "first entry is password / remote (the default)" '[[ $(grep -m1 -o "menuentry '"'"'[^'"'"']*" "$t/out.cfg") == *"password or remote"* ]]'
check "the YubiKey entry waits for the key (token-timeout=0)" 'grep -q "token-timeout=0" "$t/out.cfg"'
echo "$pass passed, $fail failed"
(( fail == 0 ))
